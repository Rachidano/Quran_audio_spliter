@page
@model IndexModel
@{
    ViewData["Title"] = "فهرس السور والبحث";
}

<form method="get" class="mb-4" role="search">
    <label for="quran-search" class="form-label fw-bold">البحث في القرآن</label>
    <div class="input-group">
        <input id="quran-search" name="q" value="@Model.Q" class="form-control" maxlength="200" placeholder="أكتب كلمة أو آية أو رقم" />
        <button class="btn btn-success" type="submit">بحث</button>
    </div>
    <p class="small text-muted mt-2">أدخل ثلاثة أحرف على الأقل، مع التشكيل أو بدونه، أو رقم السورة والآية مثل <bdi>2:4</bdi>. عند إدخال عدة كلمات من الآية، تُبحث كاملة ومتتابعة بالترتيب نفسه. اضغط على النتيجة لفتح الآية في صورة المصحف.</p>
</form>
@if (Model.Q?.Any(char.IsLetter) == true)
{
    <div class="alert alert-warning" role="status">البحث النصي تجريبي: يعتمد على نص ورش قيد التحقق، وقد تفوت بعض النتائج أو تحتاج مطابقتها إلى مراجعة. صور مصدرنا الرسمي هي مرجع العرض.</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Q))
{
    <div class="mb-4">
        <h4 class="mb-3">🔍 نتائج البحث عن : <span class="text-success">"@Model.Q"</span> (@Model.TotalResults نتيجة)</h4>
        
        @if (Model.SearchError != null)
        {
            <div class="alert alert-warning" role="alert">@Model.SearchError</div>
        }
        else if (Model.SearchResults.Count == 0)
        {
            <div class="alert alert-warning">
                لم يُعثر على نتيجة. جرّب كلمة من الآية (ثلاثة أحرف على الأقل)، أو رقم السورة والآية مثل <code>2:4</code>.
            </div>

        }
        else
        {
            <div class="list-group">
                @foreach (var item in Model.SearchResults)
                {
                    <a href="/quran/@item.SurahNumber/@item.AyahNumber" class="list-group-item list-group-item-action p-3 mb-2 rounded border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success">سورة @item.SurahNameArabic (@item.SurahNameLatin) — آية @item.AyahNumber</span>
                            <span class="btn btn-outline-success btn-sm">عرض الآية في المصحف ←</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.TextWarsh))
                        {
                            // Keep one shaping font for the whole verse when Amiri Quran lacks a character.
                            var needsFullAmiri = item.TextWarsh.Contains('\u06D2') || item.TextWarsh.Contains('\u065E');
                            // Replace only the source's trailing verse number in this preview, never in storage.
                            var versePreview = System.Text.RegularExpressions.Regex.Replace(item.TextWarsh, @"\s+[٠-٩۰-۹0-9]+\s*$", "");
                            <p class="quran-text my-3" dir="rtl" lang="ar" style="@(needsFullAmiri ? "--font-quran: 'Amiri Warsh Fallback', serif;" : null)">@versePreview <bdi class="search-ayah-number" dir="ltr">(@item.AyahNumber.ToString(System.Globalization.CultureInfo.InvariantCulture))</bdi></p>
                            <p class="small text-muted mb-2">نص مساعد للبحث — قيد المراجعة</p>
                        }
                        <p class="mb-0">صفحة @item.PageNumber — عرض الموضع في صورة المصحف</p>
                    </a>
                }
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav class="search-pagination mt-3" aria-label="صفحات نتائج البحث">
                    <p>الصفحة @Model.ResultPage من @Model.TotalPages — جميع النتائج متاحة عبر الصفحات.</p>
                    <ul class="pagination flex-wrap">
                        @if (Model.ResultPage > 1)
                        {
                            <li class="page-item"><a class="page-link" asp-page="/Index" asp-route-q="@Model.Q" asp-route-resultPage="1">الأولى</a></li>
                            <li class="page-item"><a class="page-link" asp-page="/Index" asp-route-q="@Model.Q" asp-route-resultPage="@(Model.ResultPage - 1)">السابقة</a></li>
                        }
                        @for (var n = Math.Max(1, Model.ResultPage - 2); n <= Math.Min(Model.TotalPages, Model.ResultPage + 2); n++)
                        {
                            <li class="page-item @(n == Model.ResultPage ? "active" : "")"><a class="page-link" asp-page="/Index" asp-route-q="@Model.Q" asp-route-resultPage="@n" aria-current="@(n == Model.ResultPage ? "page" : null)">@n</a></li>
                        }
                        @if (Model.ResultPage < Model.TotalPages)
                        {
                            <li class="page-item"><a class="page-link" asp-page="/Index" asp-route-q="@Model.Q" asp-route-resultPage="@(Model.ResultPage + 1)">التالية</a></li>
                            <li class="page-item"><a class="page-link" asp-page="/Index" asp-route-q="@Model.Q" asp-route-resultPage="@Model.TotalPages">الأخيرة</a></li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
    <hr class="my-5" />
}

<!-- Section d'introduction -->
<div class="text-center py-4 px-3 mb-4 rounded-4" style="background: linear-gradient(180deg, #f0fdf4, #ffffff); border: 1px solid #d1fae5;">
    <h1 class="display-6 fw-bold text-success mb-2">مصحف رواية ورش عن نافع</h1>
    <p class="lead text-secondary mb-3">بصوت فضيلة الشيخ القارئ <strong>صابر عبد الحكم</strong></p>
    <div class="d-inline-flex gap-2 flex-wrap justify-content-center">
        <a href="/surah/1" class="btn btn-quran-primary">سورة الفاتحة مباشرة</a>
        <a href="/mushaf/warsh/page/1" class="btn btn-outline-success">📖 تصفح المصحف الشريف</a>
        <a href="#surahs-grid" class="btn btn-quran-outline">فهرس السور (114)</a>
    </div>
</div>

<!-- Grille des 114 sourates -->
<div id="surahs-grid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">فهرس سور القرآن الكريم</h3>
        <span class="badge bg-secondary">114 سورة</span>
    </div>

    @if (Model.Surahs.Count == 0)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center">
            <span>البيانات المرجعية لم تُستورد بعد في قاعدة البيانات.</span>
            @if (User.IsInRole("Admin"))
            {
                <form method="post" action="/api/admin/import/seed-reference" onsubmit="event.preventDefault(); fetch('/api/admin/import/seed-reference', {method: 'POST'}).then(() => fetch('/api/admin/import/import-fatiha', {method: 'POST'})).then(() => location.reload());">
                    <button type="submit" class="btn btn-sm btn-primary">تهيئة 114 سورة و الفاتحة الآن</button>
                </form>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var surah in Model.Surahs)
            {
                <div class="col">
                    <a href="/surah/@surah.Number" class="text-decoration-none text-dark">
                        <div class="card h-100 p-3 ayah-card">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="ayah-number-badge">@surah.Number</span>
                                    <div>
                                        <h5 class="fw-bold mb-1">سورة @surah.NameArabic</h5>
                                        <small class="text-muted">@surah.NameLatin — @surah.NameTranslation</small>
                                    </div>
                                </div>
                                <div class="text-start">
                                    <span class="badge bg-light text-dark border">@surah.AyahCount آية</span>
                                    <div class="small text-muted mt-1">@(surah.RevelationType == "Meccan" ? "مكية" : "مدنية")</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
