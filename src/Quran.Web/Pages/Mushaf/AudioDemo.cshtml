@page
@model Quran.Web.Pages.Mushaf.AudioDemoModel
@{ ViewData["Title"] = "تجربة التزامن مع المصحف"; }
<link rel="stylesheet" href="~/css/warsh-pilot.css" asp-append-version="true" />
<section dir="rtl" lang="ar">
 <h1>تجربة التزامن مع المصحف</h1>
 <p class="alert alert-warning">تجربة حسب ملف ملاحظاتك الأخير، وليست مزامنة معتمدة. أرقام الآيات كما أدخلتها؛ يجب مقارنة التلاوة بالنص لأن الترقيم قد يختلف. لا يوجد تظليل في الفترة غير المعلَّمة من 67.986 إلى 84.592 ثانية.</p>
 <audio id="demo-audio" controls preload="metadata" src="/audio/sources/002/original.mp3" style="width:100%"></audio>
 <button id="demo-play" class="btn btn-success" disabled>تشغيل التجربة من أول مقطع</button>
 <p id="demo-status" role="status" aria-live="polite">تحميل الملاحظات…</p>
 <div id="demo-passages" class="d-flex flex-wrap gap-2 my-3"></div>
 <p>اختر مقطعًا أو اضغط على الآية للاستماع إلى توقيتها المسجَّل. يتوقف العرض عند نهاية العينة.</p>
 @foreach(var sheet in Model.DemoPages)
 {
  <div class="demo-page mx-auto" data-page="@sheet.Number" style="max-width:760px" hidden>
   <p>صفحة @sheet.Number</p>
   <div class="pilot-sheet">
    <img src="/api/mushaf/marw-pilot/20260913-full/pages/@sheet.Number/image.png?sha256=@sheet.Sha256" width="@sheet.Width" height="@sheet.Height" alt="صفحة @sheet.Number من مصحف الوزارة" />
    <svg class="pilot-regions" viewBox="@sheet.ViewBox" aria-label="اختيار آية">
     @foreach(var region in sheet.Regions)
     {
      <path d="@region.PathData" data-reference="@region.Reference"><title>@region.Reference</title></path>
     }
    </svg>
   </div>
  </div>
 }
 <p class="mt-3"><a href="/mushaf/audioreview">العودة إلى تحرير الملاحظات</a></p>
</section>
@section Scripts { <script src="~/js/audio-demo.js" asp-append-version="true" defer></script> }
