@page "{pageNumber:int?}"
@model Quran.Web.Pages.Admin.MushafRegionEditorModel
@{
    ViewData["Title"] = $"محرر مناطق مصحف ورش — صفحة {Model.PageNumber}";
}

<div class="container-fluid px-4 py-3" id="mushaf-region-app">
    <!-- En-tête -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded-3 shadow-sm border">
        <div class="d-flex align-items-center gap-3">
            <h1 class="h4 mb-0 fw-bold text-success d-flex align-items-center gap-2">
                <span>📐</span> محرر مناطق صفحات مصحف ورش (الرسم العثماني)
            </h1>
            <span class="badge bg-emerald-subtle text-success border border-success-subtle px-3 py-2">
                مصحف المدينة النبوية — ورش عن نافع
            </span>
        </div>

        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <button class="btn btn-sm btn-outline-secondary" onclick="navigatePage(@(Model.PageNumber - 1))" disabled="@(Model.PageNumber <= 1)">◀ الصفحة السابقة</button>
            <div class="input-group input-group-sm" style="width: 140px;">
                <span class="input-group-text">صفحة</span>
                <input type="number" id="pageNumberInput" class="form-control text-center fw-bold" value="@Model.PageNumber" min="1" max="604" onchange="navigatePage(this.value)">
            </div>
            <button class="btn btn-sm btn-outline-secondary" onclick="navigatePage(@(Model.PageNumber + 1))" disabled="@(Model.PageNumber >= 604)">الصفحة التالية ▶</button>
            <a href="/Mushaf/Page/@Model.PageNumber" target="_blank" class="btn btn-sm btn-outline-success ms-2">👁️ معاينة عامة</a>
        </div>
    </div>

    <!-- Zone principale : 2 colonnes (Page Mushaf à gauche, Liste des ayats et régions à droite) -->
    <div class="row g-3 mb-4">
        <!-- Colonne Gauche : Viewer Image Mushaf avec Canvas Overlays -->
        <div class="col-lg-8">
            <div class="card shadow-sm border h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold small text-muted">وضع العمل:</span>
                        <div class="btn-group btn-group-sm">
                            <button id="btnModeSelect" class="btn btn-primary" onclick="setMode('select')">👆 تحديد وتعديل</button>
                            <button id="btnModeDraw" class="btn btn-outline-primary" onclick="setMode('draw')">✏️ رسم منطقة جديدة</button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">التكبير:</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" onclick="setZoom(0.75)">75%</button>
                            <button class="btn btn-outline-secondary active" id="btnZoom100" onclick="setZoom(1.0)">100%</button>
                            <button class="btn btn-outline-secondary" onclick="setZoom(1.25)">125%</button>
                            <button class="btn btn-outline-secondary" onclick="setZoom(1.5)">150%</button>
                        </div>
                    </div>
                </div>

                <div class="card-body p-3 bg-dark-subtle overflow-auto text-center position-relative" style="min-height: 700px; max-height: 85vh;" id="viewerScrollContainer">
                    <div id="mushafLoading" class="position-absolute top-50 start-50 translate-middle text-center" style="z-index: 20;">
                        <div class="spinner-border text-success" role="status"></div>
                        <div class="mt-2 fw-bold text-dark">جارٍ تحميل صفحة المصحف...</div>
                    </div>

                    <!-- Wrapper de l'image du Mushaf avec position relative pour les overlays absolus -->
                    <div id="mushafImageWrapper" class="d-inline-block position-relative shadow-lg rounded" style="user-select: none; transition: transform 0.15s ease; transform-origin: top center;">
                        <img id="mushafImage" src="" alt="صفحة المصحف" class="d-block img-fluid rounded" style="max-width: 100%; height: auto;" onload="onImageLoaded()" />
                        
                        <!-- Conteneur des calques de régions -->
                        <div id="regionsOverlayContainer" class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: all;">
                            <!-- Régions générées dynamiquement -->
                        </div>

                        <!-- Boîte de dessin temporaire pendant le clic-glisser -->
                        <div id="drawingBox" class="position-absolute border border-2 border-warning bg-warning bg-opacity-25 d-none" style="pointer-events: none; z-index: 15;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Colonne Droite : Sélection de l'Ayah & Inspecteur de Régions -->
        <div class="col-lg-4">
            <!-- Carte 1 : Sélection de l'Ayah courante -->
            <div class="card shadow-sm border mb-3">
                <div class="card-header bg-white py-2">
                    <h2 class="h6 mb-0 fw-bold text-success">📖 الآيات في هذه الصفحة</h2>
                </div>
                <div class="card-body p-2" style="max-height: 250px; overflow-y: auto;">
                    <div class="list-group list-group-flush small" id="ayahsListContainer">
                        <!-- Rempli dynamiquement -->
                    </div>
                </div>
            </div>

            <!-- Carte 2 : Inspecteur de la région sélectionnée -->
            <div class="card shadow-sm border mb-3">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-primary">🎯 بيانات المنطقة المحددة</h2>
                    <span id="selectedRegionIdBadge" class="badge bg-secondary">لا يوجد تحديد</span>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-2 small">
                        <div class="col-6">
                            <label class="form-label mb-1 text-muted">X (أفقي):</label>
                            <input type="number" id="regInputX" class="form-control form-control-sm font-monospace" step="0.005" min="0" max="1" onchange="onManualCoordsChange()">
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1 text-muted">Y (عمودي):</label>
                            <input type="number" id="regInputY" class="form-control form-control-sm font-monospace" step="0.005" min="0" max="1" onchange="onManualCoordsChange()">
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1 text-muted">Width (العرض):</label>
                            <input type="number" id="regInputW" class="form-control form-control-sm font-monospace" step="0.005" min="0.01" max="1" onchange="onManualCoordsChange()">
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1 text-muted">Height (الارتفاع):</label>
                            <input type="number" id="regInputH" class="form-control form-control-sm font-monospace" step="0.005" min="0.01" max="1" onchange="onManualCoordsChange()">
                        </div>
                    </div>

                    <div class="row g-2 mb-3 small">
                        <div class="col-6">
                            <label class="form-label mb-1 text-muted">الترتيب (Sequence):</label>
                            <input type="number" id="regInputSeq" class="form-control form-control-sm" value="1" min="1">
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1 text-muted">حالة الاعتماد:</label>
                            <select id="regInputStatus" class="form-select form-select-sm">
                                <option value="1">مسودة (Draft)</option>
                                <option value="2">مراجعة (Reviewed)</option>
                                <option value="3">معتمد (Approved)</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button id="btnSaveRegion" class="btn btn-success btn-sm flex-fill" onclick="saveSelectedRegion()">💾 حفظ المنطقة</button>
                        <button id="btnDeleteRegion" class="btn btn-outline-danger btn-sm" onclick="deleteSelectedRegion()">🗑️ حذف</button>
                    </div>
                </div>
            </div>

            <!-- Carte 3 : Liste des régions existantes sur cette page -->
            <div class="card shadow-sm border">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark">📋 المناطق المحفوظة (<span id="regionsCount">0</span>)</h2>
                </div>
                <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                    <ul class="list-group list-group-flush small" id="pageRegionsList">
                        <!-- Rempli dynamiquement -->
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const currentPageNumber = @Model.PageNumber;
        let pageData = null;
        let currentMode = 'select'; // 'select' or 'draw'
        let currentZoom = 1.0;
        let selectedAyahId = null;
        let selectedRegion = null; // Region object currently active
        let isDrawing = false;
        let drawStartX = 0;
        let drawStartY = 0;

        document.addEventListener('DOMContentLoaded', async () => {
            initDrawEvents();
            await loadPageData(currentPageNumber);
        });

        function navigatePage(num) {
            if (num >= 1 && num <= 604) {
                window.location.href = `/Admin/MushafRegionEditor/${num}`;
            }
        }

        async function loadPageData(pageNumber) {
            document.getElementById('mushafLoading').style.display = 'block';
            try {
                const res = await fetch(`/api/mushaf/pages/${pageNumber}`);
                if (!res.ok) throw new Error(await res.text());
                pageData = await res.json();

                // Charger l'image WebP
                const img = document.getElementById('mushafImage');
                img.src = pageData.page.imageUrl;

                renderAyahsList(pageData.ayahs);
                renderRegionsList(pageData.ayahRegions);
            } catch (err) {
                console.error(err);
                alert('فشل في تحميل بيانات صفحة المصحف: ' + err.message);
                document.getElementById('mushafLoading').style.display = 'none';
            }
        }

        function onImageLoaded() {
            document.getElementById('mushafLoading').style.display = 'none';
            renderOverlays(pageData.ayahRegions);
        }

        function setMode(mode) {
            currentMode = mode;
            document.getElementById('btnModeSelect').className = mode === 'select' ? 'btn btn-primary' : 'btn btn-outline-primary';
            document.getElementById('btnModeDraw').className = mode === 'draw' ? 'btn btn-primary' : 'btn btn-outline-primary';

            const overlay = document.getElementById('regionsOverlayContainer');
            overlay.style.cursor = mode === 'draw' ? 'crosshair' : 'default';
        }

        function setZoom(factor) {
            currentZoom = factor;
            document.getElementById('mushafImageWrapper').style.transform = `scale(${factor})`;
            document.querySelectorAll('#viewerScrollContainer button').forEach(b => b.classList.remove('active'));
            if (factor === 1.0) document.getElementById('btnZoom100').classList.add('active');
        }

        function renderAyahsList(ayahs) {
            const list = document.getElementById('ayahsListContainer');
            list.innerHTML = '';

            if (!ayahs || ayahs.length === 0) {
                list.innerHTML = '<div class="p-3 text-muted text-center">لا توجد آيات مسجلة لهذه الصفحة</div>';
                return;
            }

            ayahs.forEach((a, idx) => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = `list-group-item list-group-item-action d-flex justify-content-between align-items-center ${idx === 0 ? 'active' : ''}`;
                item.innerHTML = `
                    <div class="text-truncate me-2">
                        <strong class="d-block">${a.surahNameArabic} — آية ${a.ayahNumber}</strong>
                        <span class="text-muted small">${a.textWarsh}</span>
                    </div>
                    <span class="badge bg-secondary-subtle text-dark">#${a.ayahNumber}</span>
                `;
                item.onclick = (e) => {
                    e.preventDefault();
                    document.querySelectorAll('#ayahsListContainer .list-group-item').forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                    selectedAyahId = a.id;
                    highlightRegionsForAyah(a.id);
                };
                list.appendChild(item);
            });

            selectedAyahId = ayahs[0].id;
        }

        function renderOverlays(regions) {
            const container = document.getElementById('regionsOverlayContainer');
            container.innerHTML = '';

            regions.forEach(r => {
                const box = document.createElement('div');
                box.id = `overlay-box-${r.id}`;
                box.className = 'position-absolute border border-2 border-emerald-500 rounded';
                box.style.left = `${r.x * 100}%`;
                box.style.top = `${r.y * 100}%`;
                box.style.width = `${r.width * 100}%`;
                box.style.height = `${r.height * 100}%`;
                box.style.backgroundColor = 'rgba(16, 185, 129, 0.2)';
                box.style.cursor = 'pointer';
                box.style.transition = 'all 0.15s ease';

                const label = document.createElement('span');
                label.className = 'badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 small';
                label.style.transform = 'translateY(-100%)';
                label.style.fontSize = '10px';
                label.textContent = `آية ${r.ayahNumber} (#${r.sequence})`;
                box.appendChild(label);

                box.onclick = (e) => {
                    e.stopPropagation();
                    selectRegion(r);
                };

                container.appendChild(box);
            });
        }

        function renderRegionsList(regions) {
            const list = document.getElementById('pageRegionsList');
            document.getElementById('regionsCount').textContent = regions.length;
            list.innerHTML = '';

            if (regions.length === 0) {
                list.innerHTML = '<li class="list-group-item text-muted text-center py-3">لا توجد مناطق مرسومة بعد</li>';
                return;
            }

            regions.forEach(r => {
                const item = document.createElement('li');
                item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                item.id = `region-item-${r.id}`;
                item.style.cursor = 'pointer';
                item.innerHTML = `
                    <div>
                        <strong>آية ${r.ayahNumber}</strong> <span class="badge bg-light text-dark border">جزء ${r.sequence}</span>
                        <div class="text-muted font-monospace" style="font-size:10px;">
                            X:${r.x.toFixed(3)} Y:${r.y.toFixed(3)} W:${r.width.toFixed(3)} H:${r.height.toFixed(3)}
                        </div>
                    </div>
                    <button class="btn btn-xs btn-outline-danger" onclick="event.stopPropagation(); deleteRegionById(${r.id})">🗑️</button>
                `;
                item.onclick = () => selectRegion(r);
                list.appendChild(item);
            });
        }

        function selectRegion(r) {
            selectedRegion = r;
            document.getElementById('selectedRegionIdBadge').className = 'badge bg-success';
            document.getElementById('selectedRegionIdBadge').textContent = `منطقة #${r.id} (آية ${r.ayahNumber})`;

            document.getElementById('regInputX').value = r.x;
            document.getElementById('regInputY').value = r.y;
            document.getElementById('regInputW').value = r.width;
            document.getElementById('regInputH').value = r.height;
            document.getElementById('regInputSeq').value = r.sequence;
            document.getElementById('regInputStatus').value = r.status;

            // Highlight box
            document.querySelectorAll('#regionsOverlayContainer > div').forEach(b => {
                b.style.borderColor = '#10b981';
                b.style.backgroundColor = 'rgba(16, 185, 129, 0.2)';
            });
            const activeBox = document.getElementById(`overlay-box-${r.id}`);
            if (activeBox) {
                activeBox.style.borderColor = '#f59e0b';
                activeBox.style.backgroundColor = 'rgba(245, 158, 11, 0.35)';
            }
        }

        function highlightRegionsForAyah(ayahId) {
            document.querySelectorAll('#regionsOverlayContainer > div').forEach(b => {
                b.style.opacity = '0.3';
            });
            if (pageData && pageData.ayahRegions) {
                pageData.ayahRegions.filter(r => r.ayahId == ayahId).forEach(r => {
                    const b = document.getElementById(`overlay-box-${r.id}`);
                    if (b) b.style.opacity = '1';
                });
            }
        }

        // Événements de dessin interactif (Click & Drag)
        function initDrawEvents() {
            const container = document.getElementById('regionsOverlayContainer');
            const box = document.getElementById('drawingBox');

            container.addEventListener('mousedown', (e) => {
                if (currentMode !== 'draw') return;
                const rect = container.getBoundingClientRect();
                drawStartX = (e.clientX - rect.left) / rect.width;
                drawStartY = (e.clientY - rect.top) / rect.height;
                isDrawing = true;

                box.style.left = `${drawStartX * 100}%`;
                box.style.top = `${drawStartY * 100}%`;
                box.style.width = '0%';
                box.style.height = '0%';
                box.classList.remove('d-none');
            });

            window.addEventListener('mousemove', (e) => {
                if (!isDrawing) return;
                const rect = container.getBoundingClientRect();
                const curX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                const curY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));

                const x = Math.min(drawStartX, curX);
                const y = Math.min(drawStartY, curY);
                const w = Math.abs(curX - drawStartX);
                const h = Math.abs(curY - drawStartY);

                box.style.left = `${x * 100}%`;
                box.style.top = `${y * 100}%`;
                box.style.width = `${w * 100}%`;
                box.style.height = `${h * 100}%`;
            });

            window.addEventListener('mouseup', async (e) => {
                if (!isDrawing) return;
                isDrawing = false;
                box.classList.add('d-none');

                const rect = container.getBoundingClientRect();
                const curX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                const curY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));

                const x = Math.min(drawStartX, curX);
                const y = Math.min(drawStartY, curY);
                const w = Math.abs(curX - drawStartX);
                const h = Math.abs(curY - drawStartY);

                // Si la taille est trop petite, ignorer (simple clic)
                if (w < 0.02 || h < 0.01) return;

                if (!selectedAyahId) {
                    alert('الرجاء تحديد آية أولاً من القائمة على اليمين قبل الرسم.');
                    return;
                }

                // Déterminer la prochaine séquence
                const existingSeq = pageData.ayahRegions
                    .filter(r => r.ayahId === selectedAyahId)
                    .map(r => r.sequence);
                const nextSeq = existingSeq.length > 0 ? Math.max(...existingSeq) + 1 : 1;

                // Créer la nouvelle région via l'API
                const payload = {
                    ayahId: selectedAyahId,
                    mushafPageId: pageData.page.id,
                    x: Math.round(x * 10000) / 10000,
                    y: Math.round(y * 10000) / 10000,
                    width: Math.round(w * 10000) / 10000,
                    height: Math.round(h * 10000) / 10000,
                    sequence: nextSeq,
                    status: 1
                };

                try {
                    const res = await fetch(`/api/admin/mushaf/ayahs/${selectedAyahId}/regions`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!res.ok) throw new Error(await res.text());
                    const created = await res.json();

                    pageData.ayahRegions.push(created);
                    renderOverlays(pageData.ayahRegions);
                    renderRegionsList(pageData.ayahRegions);
                    selectRegion(created);
                    setMode('select');
                } catch (err) {
                    alert('فشل في حفظ المنطقة المرسومة: ' + err.message);
                }
            });
        }

        async function saveSelectedRegion() {
            if (!selectedRegion) {
                alert('الرجاء تحديد منطقة لتحديثها.');
                return;
            }

            const x = parseFloat(document.getElementById('regInputX').value);
            const y = parseFloat(document.getElementById('regInputY').value);
            const w = parseFloat(document.getElementById('regInputW').value);
            const h = parseFloat(document.getElementById('regInputH').value);
            const seq = parseInt(document.getElementById('regInputSeq').value);
            const status = parseInt(document.getElementById('regInputStatus').value);

            const payload = {
                x: x,
                y: y,
                width: w,
                height: h,
                sequence: seq,
                status: status
            };

            try {
                const res = await fetch(`/api/admin/mushaf/ayah-regions/${selectedRegion.id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) throw new Error(await res.text());
                const updated = await res.json();

                const idx = pageData.ayahRegions.findIndex(r => r.id === updated.id);
                if (idx !== -1) pageData.ayahRegions[idx] = updated;

                renderOverlays(pageData.ayahRegions);
                renderRegionsList(pageData.ayahRegions);
                selectRegion(updated);
                alert('تم تحديث المنطقة بنجاح!');
            } catch (err) {
                alert('فشل التحديث: ' + err.message);
            }
        }

        async function deleteSelectedRegion() {
            if (!selectedRegion) return;
            await deleteRegionById(selectedRegion.id);
        }

        async function deleteRegionById(id) {
            if (!confirm('هل أنت متأكد من حذف هذه المنطقة؟')) return;
            try {
                const res = await fetch(`/api/admin/mushaf/ayah-regions/${id}`, { method: 'DELETE' });
                if (!res.ok) throw new Error(await res.text());

                pageData.ayahRegions = pageData.ayahRegions.filter(r => r.id !== id);
                renderOverlays(pageData.ayahRegions);
                renderRegionsList(pageData.ayahRegions);
                selectedRegion = null;
                document.getElementById('selectedRegionIdBadge').className = 'badge bg-secondary';
                document.getElementById('selectedRegionIdBadge').textContent = 'لا يوجد تحديد';
            } catch (err) {
                alert('فشل الحذف: ' + err.message);
            }
        }

        function onManualCoordsChange() {
            if (!selectedRegion) return;
            const x = parseFloat(document.getElementById('regInputX').value);
            const y = parseFloat(document.getElementById('regInputY').value);
            const w = parseFloat(document.getElementById('regInputW').value);
            const h = parseFloat(document.getElementById('regInputH').value);

            const box = document.getElementById(`overlay-box-${selectedRegion.id}`);
            if (box) {
                box.style.left = `${x * 100}%`;
                box.style.top = `${y * 100}%`;
                box.style.width = `${w * 100}%`;
                box.style.height = `${h * 100}%`;
            }
        }
    </script>
}
