@page
@model Quran.Web.Pages.Admin.ValidationModel
@{
    ViewData["Title"] = "شاشة التحقق والاعتماد الصوتي";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1">شاشة التحقق والاعتماد الصوتي للأوجه</h2>
        <p class="text-muted mb-0">الاستماع للقطع الصوتية، تعيين الوجه القرآني، والاعتماد قبل النشر للعموم (RG-06)</p>
    </div>
    <div>
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary">
            ← العودة للوحة التحكم
        </a>
    </div>
</div>

<!-- Filtres de recherche -->
<div class="card p-3 mb-4 rounded-3 border-0 shadow-sm" style="background: #f8fafc;">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold text-secondary">رقم السورة</label>
            <input type="number" name="surah" value="@Model.Surah" class="form-control" placeholder="الكل (أو 1 للفاتحة)" min="1" max="114">
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold text-secondary">حالة التدقيق</label>
            <select name="status" class="form-select">
                <option value="">جميع الحالات</option>
                <option value="Imported" selected="@(Model.Status?.ToString() == "Imported")">مستورد (Imported)</option>
                <option value="Segmented" selected="@(Model.Status?.ToString() == "Segmented")">مقطع آلياً (Segmented)</option>
                <option value="Reviewed" selected="@(Model.Status?.ToString() == "Reviewed")">مراجع (Reviewed)</option>
                <option value="Approved" selected="@(Model.Status?.ToString() == "Approved")">معتمد (Approved)</option>
                <option value="Published" selected="@(Model.Status?.ToString() == "Published")">منشور (Published)</option>
                <option value="Rejected" selected="@(Model.Status?.ToString() == "Rejected")">مرفوض (Rejected)</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-quran-primary w-100">تطبيق الفلتر</button>
        </div>
        <div class="col-md-2">
            <a asp-page="/Admin/Validation" class="btn btn-outline-secondary w-100">إعادة الضبط</a>
        </div>
    </form>
</div>

<!-- Liste des enregistrements -->
@if (Model.Recitations.Count == 0)
{
    <div class="alert alert-info text-center py-4">
        <h5>لا توجد تسجيلات تطابق معايير البحث الحالية.</h5>
        <p class="mb-0 text-muted">يمكنك معالجة مقاطع سورة الفاتحة من خلال خيار الاستيراد الآلي.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.Recitations)
        {
            <div class="card p-3 rounded-3 border shadow-sm">
                <div class="row align-items-center g-3">
                    <!-- Informations Verset -->
                    <div class="col-md-4">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success">سورة @item.SurahNameArabic</span>
                            <span class="badge bg-light text-dark border">آية @item.AyahNumber</span>
                            
                            @switch (item.Status)
                            {
                                case "Published":
                                    <span class="badge bg-success">منشور ✓</span>
                                    break;
                                case "Approved":
                                    <span class="badge bg-primary">معتمد</span>
                                    break;
                                case "Rejected":
                                    <span class="badge bg-danger">مرفوض ✗</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                    break;
                            }
                        </div>
                        <p class="quran-text mb-0 fs-5">@item.TextWarsh</p>
                    </div>

                    <!-- Audio Player -->
                    <div class="col-md-3">
                        <audio controls class="w-100" style="height: 38px;">
                            <source src="@item.AudioUrl" type="audio/mpeg">
                        </audio>
                        <div class="d-flex justify-content-between small text-muted mt-1">
                            <span>المدة : @(Math.Round(item.DurationMs / 1000.0, 1)) ث</span>
                            <span>@(Math.Round(item.SizeBytes / 1024.0, 1)) ك.ب</span>
                        </div>
                    </div>

                    <!-- Choix du Wajh -->
                    <div class="col-md-2">
                        <form method="post" asp-page-handler="UpdateWajh">
                            <input type="hidden" name="recitationId" value="@item.RecitationId" />
                            <label class="form-label small text-muted mb-1">الوجه المخصص :</label>
                            <div class="input-group input-group-sm">
                                <select name="wajhId" class="form-select">
                                    <option value="">بدون وجه</option>
                                    @foreach (var wajh in Model.AvailableAwjuh)
                                    {
                                        <option value="@wajh.Id" selected="@(item.WajhId == wajh.Id)">@wajh.NameArabic</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-outline-primary">حفظ</button>
                            </div>
                        </form>
                    </div>

                    <!-- Actions d'approbation et publication -->
                    <div class="col-md-3">
                        <div class="d-flex gap-1 justify-content-end">
                            @if (!item.IsPublished)
                            {
                                <form method="post" asp-page-handler="Publish" class="d-inline">
                                    <input type="hidden" name="recitationId" value="@item.RecitationId" />
                                    <button type="submit" class="btn btn-sm btn-success text-nowrap">
                                        🚀 نشر للعموم
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success text-nowrap" disabled>
                                    ✓ منشور
                                </button>
                            }

                            <!-- Bouton Rejeter -->
                            <button type="button" class="btn btn-sm btn-outline-danger text-nowrap" onclick="promptReject('@item.RecitationId')">
                                رفض ✗
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Formulaire modal invisible pour le rejet avec motif -->
    <form id="rejectForm" method="post" asp-page-handler="Reject" style="display: none;">
        <input type="hidden" id="rejectRecitationId" name="recitationId" value="" />
        <input type="hidden" id="rejectComment" name="comment" value="" />
    </form>
}

@section Scripts {
    <script>
        function promptReject(recitationId) {
            const comment = prompt("يرجى إدخال سبب رفض هذا المقطع الصوتي (مثال: بتر في بداية الآية، تشويش، عدم مطابقة الوجه) :");
            if (comment && comment.trim().length > 0) {
                document.getElementById('rejectRecitationId').value = recitationId;
                document.getElementById('rejectComment').value = comment.trim();
                document.getElementById('rejectForm').submit();
            }
        }
    </script>
}
