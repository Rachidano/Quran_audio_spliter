@page "/quran/{surah:int}/{ayah:int}"
@model AyahModel
@{
    ViewData["Title"] = $"سورة {Model.SurahInfo?.NameArabic} — الآية {Model.Ayah}";
}

@if (Model.SurahInfo != null && Model.AyahInfo != null)
{
    <!-- Fil d'ariane & Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">الفهرس</a></li>
            <li class="breadcrumb-item"><a href="/surah/@Model.SurahInfo.Number">سورة @Model.SurahInfo.NameArabic</a></li>
            <li class="breadcrumb-item active" aria-current="page">الآية @Model.Ayah</li>
        </ol>
    </nav>

    <!-- Carte principale de l'Ayah -->
    <div class="card p-4 p-md-5 mb-4 rounded-4 shadow-sm border-0" style="background: #ffffff;">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <div>
                <span class="ayah-number-badge fs-5">@Model.Ayah</span>
                <span class="fs-5 fw-bold ms-2">سورة @Model.SurahInfo.NameArabic (@Model.SurahInfo.NameLatin)</span>
            </div>
            <div class="d-flex gap-2">
                @if (Model.MushafPage != null)
                {
                    <a href="/mushaf/page/@Model.MushafPage.PageNumber?reference=@Model.Surah:@Model.Ayah" class="btn btn-outline-success btn-sm">
                        📖 صفحة المصحف (@Model.MushafPage.PageNumber)
                    </a>
                }
                <button class="btn btn-outline-secondary btn-sm" id="share-canonical-btn" onclick="copyCanonicalUrl()">
                    مشاركة الرابط 🔗
                </button>
            </div>
        </div>

        @if (Model.MarwImageUrl != null)
        {
            <a href="/mushaf/page/@Model.MarwPageNumber?reference=@Model.Surah:@Model.Ayah" class="d-block text-center my-3">
                <img src="@Model.MarwImageUrl" alt="صفحة المصحف @Model.MarwPageNumber" class="img-fluid" style="max-height:700px" />
                <span class="d-block">عرض الآية محددة في المصحف</span>
            </a>
            <details class="alert alert-warning">
                <summary>النص الرقمي المقارن — مطابقة نسخة QPC مع MARW قيد المراجعة</summary>
                <p class="quran-text fs-4">@Model.AyahInfo.TextWarsh</p>
            </details>
        }
        else if (Model.MushafPage != null && Model.MushafRegions.Count > 0)
        {
            <!-- Affichage fidèle du Mushaf Warsh officiel (الرسم العثماني) -->
            <div class="mushaf-crop-container my-4 text-center p-3 p-md-4 rounded-4 bg-white border shadow-sm" style="border-color: #e2e8f0;">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
                    <span class="badge bg-success-subtle text-success fs-6 border border-success-subtle px-3 py-2 d-flex align-items-center gap-2">
                        <span>📖</span> الرسم العثماني — مصحف الجزائر الإلكتروني (صفحة @Model.MushafPage.PageNumber)
                    </span>
                    <a href="/mushaf/page/@Model.MushafPage.PageNumber?reference=@Model.Surah:@Model.Ayah" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 fw-bold">
                        <span>عرض في صفحة المصحف الكاملة</span> <span>↗</span>
                    </a>
                </div>

                <!-- Découpage / Crop vectoriel de l'Ayah -->
                <div class="d-flex flex-column gap-3 align-items-center justify-content-center py-2">
                    @foreach (var region in Model.MushafRegions.OrderBy(r => r.Sequence))
                    {
                        var inv = System.Globalization.CultureInfo.InvariantCulture;
                        var vb = $"{region.X.ToString(inv)} {region.Y.ToString(inv)} {region.Width.ToString(inv)} {region.Height.ToString(inv)}";
                        <div class="mushaf-region-crop shadow-sm" style="max-width: 850px; width: 100%; border-radius: 8px; overflow: hidden; border: 1px solid #cbd5e1; background: #fffdf7;">
                            <svg viewBox="@vb" width="100%" style="display: block; max-height: 180px;" preserveAspectRatio="xMidYMid meet">
                                <image href="@Model.MushafPage.ImageUrl" x="0" y="0" width="1" height="1" preserveAspectRatio="none" />
                            </svg>
                        </div>
                    }
                </div>

                <!-- Texte Unicode pour la recherche et l'indexation -->
                <div class="mt-3 pt-3 border-top text-end">
                    <details class="text-muted small">
                        <summary class="cursor-pointer fw-semibold text-secondary" style="cursor: pointer;">
                            ℹ️ النص الرقمي للبحث والأرشفة (Unicode)
                        </summary>
                        <div class="p-3 mt-2 rounded bg-light border text-center">
                            <p class="quran-text fs-4 mb-0 text-dark" style="line-height: 2;">
                                @Model.AyahInfo.TextWarsh
                            </p>
                        </div>
                    </details>
                </div>
            </div>
        }
        else
        {
            <!-- Fallback Texte Warsh si les coordonnées graphiques ne sont pas encore annotées -->
            <div class="text-center py-4 my-2">
                <p class="quran-text display-6 mb-0" style="line-height: 2.4;">
                    @Model.AyahInfo.TextWarsh
                </p>
            </div>
        }

        <!-- Détails de récitation & Awjuh -->
        <div class="mt-4 p-4 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
            <div class="row g-3">
                <div class="col-md-6">
                    <p class="mb-1 text-muted small">القارئ الشيخ :</p>
                    <h6 class="fw-bold text-success mb-3">صابر عبد الحكم</h6>

                    <p class="mb-1 text-muted small">الرواية وطريق القراءة :</p>
                    <h6 class="fw-bold text-success mb-0">ورش عن نافع من طريق الشاطبية</h6>
                </div>

                <div class="col-md-6">
                    <p class="mb-2 text-muted small">الأوجه القرآنية المعتمدة لهذه الآية :</p>
                    @if (Model.AyahInfo.Recitations.Count > 0)
                    {
                        var activeRec = Model.SelectedRecitation ?? Model.AyahInfo.Recitations.First();
                        <div class="d-flex flex-column gap-2" id="wajh-selector">
                            @for (int i = 0; i < Model.AyahInfo.Recitations.Count; i++)
                            {
                                var rec = Model.AyahInfo.Recitations[i];
                                var isChecked = rec.Id == activeRec.Id;
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="wajhRadio" id="wajh-@i"
                                           value="@rec.AudioUrl"
                                           data-code="@(rec.WajhCode ?? "")"
                                           data-name="@(rec.WajhNameArabic ?? rec.WajhCode ?? "الوجه الافتراضي")"
                                           @(isChecked ? "checked" : "")
                                           onchange="updateAudioPlayer(this.value, this.dataset.code, this.dataset.name)">
                                    <label class="form-check-label fw-semibold" for="wajh-@i">
                                        @(rec.WajhNameArabic ?? rec.WajhCode ?? $"الوجه {i + 1}")
                                    </label>
                                </div>
                            }
                        </div>

                        <!-- Player Audio interactif -->
                        <div class="mt-3 pt-3 border-top">
                            <audio id="main-audio-player" controls class="w-100 mb-2">
                                <source src="@activeRec.AudioUrl" type="audio/mpeg">
                                متصفحك لا يدعم تشغيل الصوت المباشر.
                            </audio>
                            <div class="d-flex gap-2">
                                <a id="download-btn" href="@activeRec.AudioUrl"
                                   download="سورة_@(Model.SurahInfo.NameArabic)_الآية_@(Model.Ayah)_@(activeRec.WajhCode ?? "ورش").mp3"
                                   class="btn btn-quran-primary btn-sm flex-grow-1">
                                    ⬇ تحميل هذا المقطع بصيغة MP3
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted mb-0">
                            ⏳ تسجيلات الأوجه لهذه الآية تحت المراجعة والربط الصوتي مع التلاوة الأصلية.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Raccourcis clavier info -->
        <div class="text-center my-3 text-muted small">
            <span>💡 اختصارات لوحة المفاتيح: </span>
            <kbd>←</kbd> الآية السابقة &nbsp;|&nbsp;
            <kbd>→</kbd> الآية التالية &nbsp;|&nbsp;
            <kbd>Space</kbd> تشغيل / إيقاف التلاوة
        </div>

        <!-- Boutons de navigation Précédente / Suivante -->
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            @if (Model.PrevAyahNumber.HasValue)
            {
                <a href="/quran/@Model.Surah/@Model.PrevAyahNumber.Value" class="btn btn-outline-dark" id="btn-prev-ayah">
                    ← الآية السابقة (@Model.PrevAyahNumber.Value)
                </a>
            }
            else
            {
                <div></div>
            }

            <a href="/surah/@Model.Surah" class="btn btn-quran-outline">
                عرض كامل سورة @Model.SurahInfo.NameArabic
            </a>

            @if (Model.NextAyahNumber.HasValue)
            {
                <a href="/quran/@Model.Surah/@Model.NextAyahNumber.Value" class="btn btn-outline-dark" id="btn-next-ayah">
                    الآية التالية (@Model.NextAyahNumber.Value) →
                </a>
            }
            else
            {
                <div></div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        let currentWajhCode = '@(Model.SelectedRecitation?.WajhCode ?? "")';

        function updateAudioPlayer(audioUrl, wajhCode, wajhName) {
            const player = document.getElementById('main-audio-player');
            const downloadBtn = document.getElementById('download-btn');
            currentWajhCode = wajhCode;

            if (player) {
                player.src = audioUrl;
                player.play();
            }
            if (downloadBtn) {
                downloadBtn.href = audioUrl;
                downloadBtn.setAttribute('download', `سورة_@(Model.SurahInfo?.NameArabic ?? "القرآن")_الآية_@(Model.Ayah)_${wajhCode || "ورش"}.mp3`);
            }

            // Met à jour l'URL sans recharger la page
            const newUrl = window.location.pathname + (wajhCode ? `?wajh=${encodeURIComponent(wajhCode)}` : '');
            window.history.replaceState(null, '', newUrl);
        }

        function copyCanonicalUrl() {
            const url = window.location.origin + window.location.pathname + (currentWajhCode ? `?wajh=${encodeURIComponent(currentWajhCode)}` : '');
            navigator.clipboard.writeText(url).then(() => {
                const btn = document.getElementById('share-canonical-btn');
                const orig = btn.innerText;
                btn.innerText = '✓ تم النسخ!';
                btn.classList.replace('btn-outline-secondary', 'btn-success');
                setTimeout(() => {
                    btn.innerText = orig;
                    btn.classList.replace('btn-success', 'btn-outline-secondary');
                }, 2000);
            });
        }

        // Navigation au clavier
        document.addEventListener('keydown', (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;

            if (e.key === 'ArrowLeft') {
                const prev = document.getElementById('btn-prev-ayah');
                if (prev) prev.click();
            } else if (e.key === 'ArrowRight') {
                const next = document.getElementById('btn-next-ayah');
                if (next) next.click();
            } else if (e.key === ' ' || e.code === 'Space') {
                const player = document.getElementById('main-audio-player');
                if (player) {
                    e.preventDefault();
                    if (player.paused) player.play();
                    else player.pause();
                }
            }
        });
    </script>
}
