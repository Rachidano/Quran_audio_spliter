<UserControl x:Class="QuranVideo.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QuranVideo.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             FlowDirection="RightToLeft"
             d:DesignHeight="750" d:DesignWidth="1050">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Bar (Title & Search/Reciter) -->
            <RowDefinition Height="Auto"/> <!-- 1: Last Work Card -->
            <RowDefinition Height="*"/>    <!-- 2: Surahs Table / Search Results -->
            <RowDefinition Height="Auto"/> <!-- 3: Bottom Notice -->
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. EN-TÊTE : TITRE + RECHERCHE & RÉCITATEUR (1.png)       -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titre et sous-titre -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="المكتبة" FontSize="24" FontWeight="Bold" Foreground="#0f172a"/>
                <TextBlock Text="اختر السورة وابدأ العمل" FontSize="13" Foreground="#64748b" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Récitateur & Champ de recherche -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Sélecteur / Badge Récitateur -->
                <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎙️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentReciterName}" FontWeight="SemiBold" Foreground="#334155" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Champ de recherche stylisé -->
                <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Width="300" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94a3b8"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="4,4" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="أكتب كلمة أو آية أو رقم..." IsHitTestVisible="False" Foreground="#94a3b8" 
                                   FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Message de validation de recherche si applicable -->
        <Border Grid.Row="0" Background="#fffbeb" BorderBrush="#fde68a" BorderThickness="1" CornerRadius="6" 
                Padding="12,8" Margin="0,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="400"
                Visibility="{Binding HasSearchValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding SearchValidationMessage}" Foreground="#b45309" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- ======================================================== -->
        <!-- 1. CARTE « آخر عمل » (REPRISE RAPIDE DU DERNIER TRAVAIL)   -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" 
                Padding="18,14" Margin="0,0,0,18"
                Visibility="{Binding HasLastWorkedAyah, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Mini waveform / player -->
                    <ColumnDefinition Width="*"/>    <!-- Titre et description de l'ayah -->
                    <ColumnDefinition Width="Auto"/> <!-- Miniature preview & bouton -->
                </Grid.ColumnDefinitions>

                <!-- Mini waveform & bouton lecture à gauche -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ResumeLastWorkCommand}" Background="#15803d" Foreground="White"
                            Width="36" Height="36" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0" ToolTip="متابعة العمل في الاستوديو">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18"/></Style></Button.Resources>
                        <TextBlock Text="▶" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Border Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" FontSize="13" Foreground="#15803d" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="التوقيت :" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding LastWorkedAudioTime}" FontSize="12" FontWeight="Bold" Foreground="#15803d" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Description centrale -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="آخر عمل" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LastWorkedDescription}" FontSize="18" FontWeight="Bold" Foreground="#0f172a" 
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Vignette et bouton de reprise à droite -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" 
                            Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖼️" Margin="0,0,6,0"/>
                            <TextBlock Text="صورة الآية من المصدر الرسمي" FontSize="11" Foreground="#64748b"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ResumeLastWorkCommand}" Background="#15803d" Foreground="White"
                            FontWeight="Bold" FontSize="13" Padding="16,8" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <TextBlock Text="متابعة العمل ⬅"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. TABLE DES SOURATES / RÉSULTATS DE RECHERCHE           -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2">
            
            <!-- MODE 1 : RÉSULTATS DE RECHERCHE TEXTUELLE -->
            <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding SearchTotalCount, StringFormat='نتائج البحث : {0} آية مطابقة'}" 
                               FontSize="15" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                </DockPanel>

                <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8">
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SurahNameArabic, StringFormat='سورة {0}'}" FontSize="14" FontWeight="Bold" Foreground="#15803d" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding AyahNumber, StringFormat='({0})'}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" FlowDirection="LeftToRight"/>
                                                <TextBlock Text="{Binding PageNumber, StringFormat=' — صفحة {0}'}" FontSize="12" Foreground="#64748b" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OriginalText}" FontSize="16" LineHeight="26" Foreground="#1e293b" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Command="{Binding DataContext.OpenSearchResultInStudioCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Background="#f0fdf4" Foreground="#166534" BorderBrush="#86efac" BorderThickness="1"
                                                Padding="12,6" Cursor="Hand" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <TextBlock Text="اختيار الآية 🎬" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Pagination -->
                <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Command="{Binding PreviousSearchPageCommand}" Background="#f1f5f9" Foreground="#334155"
                                    FontWeight="Bold" Padding="12,5" BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <TextBlock Text="السابق ➡"/>
                            </Button>
                            <Button Command="{Binding NextSearchPageCommand}" Background="#f1f5f9" Foreground="#334155"
                                    FontWeight="Bold" Padding="12,5" BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <TextBlock Text="⬅ التالي"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="الصفحة " Foreground="#64748b"/>
                            <TextBlock Text="{Binding SearchCurrentPage}" FontWeight="Bold" Foreground="#0f172a" FlowDirection="LeftToRight"/>
                            <TextBlock Text=" من " Foreground="#64748b"/>
                            <TextBlock Text="{Binding SearchTotalPages}" FontWeight="Bold" Foreground="#0f172a" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- MODE 2 : TABLE MODERNE DES SOURATES (1.png) -->
            <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- En-têtes de colonnes -->
                        <RowDefinition Height="*"/>    <!-- Liste des lignes -->
                    </Grid.RowDefinitions>

                    <!-- En-têtes du tableau -->
                    <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" 
                            CornerRadius="10,10,0,0" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/> <!-- السورة -->
                                <ColumnDefinition Width="200"/> <!-- التسجيل الصوتي -->
                                <ColumnDefinition Width="*"/>   <!-- الآيات الجاهزة -->
                                <ColumnDefinition Width="150"/> <!-- الإجراء -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="السورة" FontWeight="Bold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="التسجيل الصوتي" FontWeight="Bold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="الآيات الجاهزة" FontWeight="Bold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Grid.Column="3" Text="الإجراء" FontWeight="Bold" Foreground="#475569" FontSize="13" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Lignes du tableau -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding SurahItems}" SelectedItem="{Binding SelectedSurahItem}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="20,12" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Colonne : السورة -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" 
                                                    CornerRadius="6" Width="38" Height="38" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Number}" FlowDirection="LeftToRight" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           FontWeight="Bold" Foreground="#475569" FontSize="13"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NameArabic}" FontSize="15" FontWeight="Bold" Foreground="#0f172a"/>
                                                <TextBlock Text="{Binding NameLatin}" FontSize="11" Foreground="#64748b" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2. Colonne : التسجيل الصوتي -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" 
                                                    CornerRadius="12" Padding="8,3" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✓" Foreground="#15803d" FontWeight="Bold" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding AudioStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#15803d"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding AudioDurationText}" FontSize="12" Foreground="#64748b" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 3. Colonne : الآيات الجاهزة -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Ratio texte -->
                                            <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="13" 
                                                       FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>

                                            <!-- Barre de progression moderne -->
                                            <ProgressBar Grid.Column="1" Value="{Binding ProgressPercentage, Mode=OneWay}" 
                                                         Maximum="100" Height="8" Margin="8,0,0,0"
                                                         Foreground="#15803d" Background="#e2e8f0" BorderThickness="0">
                                                <ProgressBar.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </ProgressBar.Resources>
                                            </ProgressBar>
                                        </Grid>

                                        <!-- 4. Colonne : الإجراء -->
                                        <Button Grid.Column="3" 
                                                Command="{Binding DataContext.OpenSurahCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="16,7" Cursor="Hand" HorizontalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <!-- Style dynamique : vert si travail commencé, neutre si début -->
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#0f172a"/>
                                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWorkStarted}" Value="True">
                                                            <Setter Property="Background" Value="#15803d"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <TextBlock Text="{Binding ActionButtonText}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. PIED DE PAGE : NOTICE HORS-LIGNE & GESTION DES SOURCES-->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="ℹ️ يمكن العمل دون اتصال بعد تنزيل التسجيل" 
                           FontSize="12" Foreground="#64748b" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="المصحف الشريف برواية ورش عن نافع — مستخرج بدقة من مصحف الجزائر الإلكتروني" 
                           FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
