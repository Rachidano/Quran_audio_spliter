<UserControl x:Class="QuranVideo.Desktop.Views.MyVideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QuranVideo.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MyVideosViewModel}"
             FlowDirection="RightToLeft"
             d:DesignHeight="850" d:DesignWidth="1150">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PageNavButton" TargetType="Button">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <!-- Layout 2 Colonnes : Colonne 0 = Liste paginée (Droite en RTL), Colonne 1 = Lecteur multimédia (Gauche en RTL) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>     <!-- Colonne 0 : Liste paginée des vidéos -->
            <ColumnDefinition Width="470"/>   <!-- Colonne 1 : Lecteur & détails -->
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- COLONNE 0 : LISTE PAGINÉE DES VIDÉOS & RECHERCHE         -->
        <!-- ======================================================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- En-tête : Titre + Recherche + Filtres -->
                <RowDefinition Height="*"/>    <!-- Liste paginée des fichiers -->
                <RowDefinition Height="Auto"/> <!-- Barre de pagination -->
            </Grid.RowDefinitions>

            <!-- 1. En-tête avec titre, recherche et filtres de médias -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="فيديوهاتي" FontSize="22" FontWeight="Bold" Foreground="#0f172a"/>
                        <TextBlock Text="استعراض وإدارة جميع المقاطع المنتجة" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Command="{Binding RefreshVideosCommand}" Background="#f8fafc" Foreground="#475569"
                                Padding="12,6" BorderThickness="1" BorderBrush="#e2e8f0" Cursor="Hand" ToolTip="تحديث القائمة">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="تحديث 🔄" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Barre d'outils : Recherche et Pilules de filtre -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Champ de recherche stylisé -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94a3b8"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="13" Padding="4,2" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="البحث في الملفات والآيات..." IsHitTestVisible="False" Foreground="#94a3b8" 
                                       FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Filtres par type : الكل, فيديو, صوت -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- 1. الكل -->
                        <Button Command="{Binding SetFilterAllCommand}" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="#15803d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <TextBlock Text="الكل" FontSize="12"/>
                        </Button>

                        <!-- 2. فيديو -->
                        <Button Command="{Binding SetFilterVideoCommand}" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterVideo}" Value="True">
                                            <Setter Property="Background" Value="#15803d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <TextBlock Text="فيديو" FontSize="12"/>
                        </Button>

                        <!-- 3. صوت -->
                        <Button Command="{Binding SetFilterAudioCommand}" Padding="14,6" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAudio}" Value="True">
                                            <Setter Property="Background" Value="#15803d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <TextBlock Text="صوت" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 2. Liste structurée et paginée des vidéos (adaptée pour 500+ vidéos) -->
            <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="8">
                <Grid>
                    <!-- Empty State: Aucun fichier -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,48"
                                Visibility="{Binding HasNoVideos, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🎞️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="لا توجد مقاطع فيديو منشأة بعد" FontSize="16" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="قم بتصدير مقطعك الأول من استوديو التقطيع أو معالج الفيديو ليظهر هنا." FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Liste des éléments de la page active -->
                    <ListBox ItemsSource="{Binding PagedVideos}" SelectedItem="{Binding SelectedVideo}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#f1f5f9"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#cbd5e1"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#f0fdf4"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#86efac"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Bouton Play direct -->
                                        <ColumnDefinition Width="Auto"/> <!-- Format Badge -->
                                        <ColumnDefinition Width="*"/>    <!-- Titre & Date -->
                                        <ColumnDefinition Width="Auto"/> <!-- Taille -->
                                        <ColumnDefinition Width="Auto"/> <!-- Actions rapides -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Bouton Play instantané -->
                                    <Button Grid.Column="0" 
                                            Command="{Binding DataContext.PlayVideoDirectlyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#15803d" Foreground="White" Width="32" Height="32"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="تشغيل هذا المقطع فوراً">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                                        <TextBlock Text="▶" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- 2. Badge de format (MP4 / MP3) -->
                                    <Border Grid.Column="1" Background="#e0f2fe" BorderBrush="#bae6fd" BorderThickness="1" 
                                            CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="#0284c7"/>
                                    </Border>

                                    <!-- 3. Titre et Date de création -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CleanTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#64748b" Margin="0,2,0,0">
                                            <Run Text="{Binding FormattedDate, Mode=OneWay}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding FileName, Mode=OneWay}" Foreground="#94a3b8"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 4. Taille du fichier -->
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="#475569" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="12,0"/>

                                    <!-- 5. Actions d'édition (Renommer, Supprimer) -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.StartRenameVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" ToolTip="إعادة تسمية">
                                            <TextBlock Text="✏️" FontSize="12"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" ToolTip="حذف">
                                            <TextBlock Text="🗑️" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 3. Barre de pagination stylisée en bas de la liste -->
            <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
                <DockPanel LastChildFill="False">
                    <!-- Contrôles de navigation dans les pages -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Première page -->
                        <Button Style="{StaticResource PageNavButton}" Command="{Binding FirstPageCommand}" ToolTip="الصفحة الأولى">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="⏮ الأولى"/>
                        </Button>

                        <!-- Page précédente -->
                        <Button Style="{StaticResource PageNavButton}" Command="{Binding PreviousPageCommand}" ToolTip="الصفحة السابقة">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="◀ السابقة"/>
                        </Button>
                    </StackPanel>

                    <!-- Indicateur de page au centre -->
                    <Border DockPanel.Dock="Right" Background="#f1f5f9" CornerRadius="6" Padding="14,6" Margin="6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageInfoDescription}" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                    </Border>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Page suivante -->
                        <Button Style="{StaticResource PageNavButton}" Command="{Binding NextPageCommand}" ToolTip="الصفحة التالية">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="التالية ▶"/>
                        </Button>

                        <!-- Dernière page -->
                        <Button Style="{StaticResource PageNavButton}" Command="{Binding LastPageCommand}" ToolTip="الصفحة الأخيرة">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="الأخيرة ⏭"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- COLONNE 1 : LECTEUR MULTIMÉDIA & DÉTAILS DU FICHIER       -->
        <!-- ======================================================== -->
        <Border Grid.Column="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Écran de lecture MediaElement -->
                    <RowDefinition Height="Auto"/> <!-- Contrôles du lecteur (Timeline, Play, Volume) -->
                    <RowDefinition Height="*"/>    <!-- Métadonnées & actions -->
                </Grid.RowDefinitions>

                <!-- 1. Écran de visualisation (MediaElement) -->
                <Border Grid.Row="0" Background="#0b1329" CornerRadius="10" Height="250" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="PlayerMediaElement"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      MediaOpened="OnMediaOpened"
                                      MediaEnded="OnMediaEnded"
                                      MediaFailed="OnMediaFailed"
                                      Volume="{Binding Volume}"
                                      IsMuted="{Binding IsMuted}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        <!-- Message d'erreur éventuel -->
                        <Border Background="#ccdc2626" CornerRadius="6" Padding="12,6"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasPlayerError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding PlayerStatusMessage}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Barre de contrôle du lecteur -->
                <StackPanel Grid.Row="1" Margin="0,12,0,16">
                    <!-- Barre de progression temporelle (Slider) -->
                    <Slider x:Name="PlayerProgressBar"
                            Minimum="0"
                            Maximum="{Binding TotalDurationSec}"
                            Value="{Binding PlaybackPositionSec, Mode=TwoWay}"
                            ValueChanged="OnScrubberValueChanged"
                            IsMoveToPointEnabled="True"
                            Height="20"
                            Margin="0,0,0,8"
                            Cursor="Hand"/>

                    <!-- Boutons et affichage du temps -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Bouton Play/Pause -->
                            <ColumnDefinition Width="*"/>    <!-- Temps écoulé / total -->
                            <ColumnDefinition Width="Auto"/> <!-- Volume & Plein écran -->
                        </Grid.ColumnDefinitions>

                        <!-- Boutons Lecture / Pause et Stop -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding TogglePlayPauseCommand}" 
                                    Background="#15803d" Foreground="White" Width="38" Height="38" 
                                    BorderThickness="0" Cursor="Hand" ToolTip="تشغيل / إيقاف مؤقت">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="19"/></Style></Button.Resources>
                                <TextBlock FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="⏸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Bouton Stop -->
                            <Button Command="{Binding StopCommand}" 
                                    Background="#f1f5f9" Foreground="#dc2626" Width="34" Height="34" 
                                    BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand" Margin="6,0,0,0" ToolTip="إيقاف كلي للتشغيل">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                                <TextBlock Text="⏹" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Affichage du temps : 00:00 / 01:24 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding FormattedPlaybackPosition}" FontWeight="Bold" Foreground="#0f172a" FontSize="13" FlowDirection="LeftToRight"/>
                            <TextBlock Text=" / " Foreground="#64748b" FontSize="13"/>
                            <TextBlock Text="{Binding FormattedTotalDuration}" Foreground="#64748b" FontSize="13" FlowDirection="LeftToRight"/>
                        </StackPanel>

                        <!-- Volume et Plein écran -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Couper / Activer le son -->
                            <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" 
                                    Padding="6,4" Cursor="Hand" Margin="0,0,4,0" ToolTip="كتم / تفعيل الصوت">
                                <TextBlock FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔊"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Text" Value="🔇"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Plein écran -->
                            <Button Command="{Binding ToggleFullscreenCommand}" Background="Transparent" BorderThickness="0" 
                                    Padding="6,4" Cursor="Hand" ToolTip="ملء الشاشة">
                                <TextBlock FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⛶"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                    <Setter Property="Text" Value="🗗"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 3. Fiche détaillée du fichier sélectionné, actions et texte de publication (sans défilement) -->
                <Border Grid.Row="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <!-- En-tête : badge + titre (nom complet au survol) + actions compactes -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#e0f2fe" BorderBrush="#bae6fd" BorderThickness="1"
                                    CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedVideo.FormatBadge, FallbackValue='MP4'}" FontSize="10" FontWeight="Bold" Foreground="#0284c7"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedVideo.CleanTitle, FallbackValue='لا يوجد ملف محدد'}"
                                       ToolTip="{Binding SelectedVideo.FileName}"
                                       FontWeight="Bold" FontSize="14" Foreground="#0f172a" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Command="{Binding OpenVideosFolderCommand}" Width="32" Height="30" Margin="0,0,6,0"
                                        Background="#15803d" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="فتح المجلد في مستكشف Windows">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <TextBlock Text="📁" FontSize="13"/>
                                </Button>
                                <Button Command="{Binding PlayInExternalPlayerCommand}" Width="32" Height="30"
                                        Background="#f1f5f9" Foreground="#334155" BorderBrush="#cbd5e1" BorderThickness="1" Cursor="Hand"
                                        ToolTip="تشغيل في مشغل وسائط خارجي (VLC, Media Player)">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <TextBlock Text="↗" FontSize="13" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Informations sur une seule ligne -->
                        <TextBlock FontSize="11" Foreground="#64748b" Margin="0,6,0,0">
                            <Run Text="📅"/>
                            <Run Text="{Binding SelectedVideo.FormattedDate, Mode=OneWay, FallbackValue='-'}" Foreground="#334155"/>
                            <Run Text="   •   💾"/>
                            <Run Text="{Binding SelectedVideo.FormattedSize, Mode=OneWay, FallbackValue='-'}" Foreground="#334155"/>
                        </TextBlock>

                        <!-- Texte de publication : titre et description prêts à copier -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsPublicationPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📝 نص النشر" FontWeight="Bold" FontSize="13" Foreground="#166534" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PublicationStatusMessage}" FontSize="11" Foreground="#15803d"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0"
                                           ToolTip="{Binding PublicationStatusMessage}"/>
                                <Button Grid.Column="2" Command="{Binding GeneratePublicationTextCommand}" Background="#f0fdf4" Foreground="#15803d"
                                        BorderBrush="#86efac" BorderThickness="1" FontSize="11" FontWeight="Bold" Padding="8,3" Cursor="Hand"
                                        ToolTip="إنشاء العنوان والوصف من معلومات الفيديو (السورة، الآيات، القارئ، الرواية)">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <TextBlock Text="{Binding GeneratePublicationTextLabel}"/>
                                </Button>
                            </Grid>

                            <StackPanel Visibility="{Binding HasPublicationText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Titre : 2 lignes au maximum, texte complet au survol, copie du texte complet -->
                                <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="العنوان" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
                                            <TextBlock Text="{Binding PublicationTitle}" ToolTip="{Binding PublicationTitle}" FontSize="12" Foreground="#0f172a"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17"
                                                       LineStackingStrategy="BlockLineHeight" MaxHeight="34"/>
                                        </StackPanel>
                                        <!-- RTL : la dernière colonne est affichée à gauche -->
                                        <Button Grid.Column="1" Command="{Binding CopyPublicationTitleCommand}" VerticalAlignment="Center"
                                                Width="30" Height="30" Padding="0" Background="#15803d" Foreground="White" BorderThickness="0"
                                                Cursor="Hand" ToolTip="نسخ العنوان إلى الحافظة">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Description : 3 lignes au maximum, texte complet au survol, copie du texte complet -->
                                <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="الوصف" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
                                            <TextBlock Text="{Binding PublicationDescription}" ToolTip="{Binding PublicationDescription}" FontSize="12" Foreground="#334155"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17"
                                                       LineStackingStrategy="BlockLineHeight" MaxHeight="51"/>
                                        </StackPanel>
                                        <!-- RTL : la dernière colonne est affichée à gauche -->
                                        <Button Grid.Column="1" Command="{Binding CopyPublicationDescriptionCommand}" VerticalAlignment="Center"
                                                Width="30" Height="30" Padding="0" Background="#15803d" Foreground="White" BorderThickness="0"
                                                Cursor="Hand" ToolTip="نسخ الوصف كاملاً إلى الحافظة">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Boîte de dialogue intégrée pour renommer un fichier -->
        <Border Grid.ColumnSpan="2" Background="#80000000"
                Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" 
                    Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إعادة تسمية الملف" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding NewVideoName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Height="38" 
                             VerticalContentAlignment="Center" Margin="0,0,0,16" Padding="6"/>
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right" Command="{Binding ConfirmRenameCommand}" Background="#15803d" Foreground="White"
                                FontWeight="Bold" Padding="16,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="حفظ التعديل ✔"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding CancelRenameCommand}" Background="#f1f5f9" Foreground="#475569"
                                FontWeight="SemiBold" Padding="14,8" BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="إلغاء ✖"/>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
