<UserControl x:Class="QuranVideo.Desktop.Views.MyVideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QuranVideo.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MyVideosViewModel}"
             FlowDirection="RightToLeft"
             d:DesignHeight="800" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <!-- Layout 2 Colonnes : Colonne 0 = Galerie & Recherche, Colonne 1 = Lecteur multimédia -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>     <!-- Colonne 0 : Grille des vidéos (Droite en RTL) -->
            <ColumnDefinition Width="460"/>   <!-- Colonne 1 : Lecteur & détails (Gauche en RTL) -->
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- COLONNE 0 : GALERIE DES VIDÉOS & FILTRES (5.png)         -->
        <!-- ======================================================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- En-tête : Titre + Recherche + Filtres -->
                <RowDefinition Height="*"/>    <!-- Grille des cartes -->
            </Grid.RowDefinitions>

            <!-- En-tête avec titre, recherche et filtres de médias -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="فيديوهاتي" FontSize="22" FontWeight="Bold" Foreground="#0f172a"/>
                    </StackPanel>
                    
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Command="{Binding RefreshVideosCommand}" Background="#f8fafc" Foreground="#475569"
                                Padding="12,6" BorderThickness="1" BorderBrush="#e2e8f0" Cursor="Hand" ToolTip="تحديث القائمة">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="تحديث 🔄" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Barre d'outils : Recherche à droite, Pilules de filtre à gauche -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Champ de recherche stylisé -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94a3b8"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="13" Padding="4,2" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="البحث في الملفات..." IsHitTestVisible="False" Foreground="#94a3b8" 
                                       FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Filtres par type : الكل, فيديو, صوت -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- 1. الكل -->
                        <Button Command="{Binding SetFilterAllCommand}" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="#15803d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <TextBlock Text="الكل" FontSize="12"/>
                        </Button>

                        <!-- 2. فيديو -->
                        <Button Command="{Binding SetFilterVideoCommand}" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterVideo}" Value="True">
                                            <Setter Property="Background" Value="#15803d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <TextBlock Text="فيديو" FontSize="12"/>
                        </Button>

                        <!-- 3. صوت -->
                        <Button Command="{Binding SetFilterAudioCommand}" Padding="14,6" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAudio}" Value="True">
                                            <Setter Property="Background" Value="#15803d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <TextBlock Text="صوت" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Grille des cartes des vidéos produites -->
            <Border Grid.Row="1" Background="Transparent">
                <ListBox ItemsSource="{Binding FilteredVideos}" SelectedItem="{Binding SelectedVideo}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" 
                                    Width="240" Margin="0,0,14,14" Padding="12" Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/> <!-- Miniature / Aperçu -->
                                        <RowDefinition Height="Auto"/> <!-- Titre & Date -->
                                        <RowDefinition Height="Auto"/> <!-- Badges & Menu -->
                                    </Grid.RowDefinitions>

                                    <!-- 1. Miniature avec cadre foncé & badge durée -->
                                    <Border Grid.Row="0" Background="#0f172a" CornerRadius="8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                            <!-- Badge durée en bas à droite -->
                                            <Border Background="#cc000000" CornerRadius="4" Padding="6,2" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="White" FlowDirection="LeftToRight"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 2. Titre et Date -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding CleanTitle}" FontSize="14" FontWeight="Bold" Foreground="#0f172a" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 3. Badges de format & Menu d'actions -->
                                    <DockPanel Grid.Row="2">
                                        <!-- Badge MP4 / MP3 -->
                                        <Border DockPanel.Dock="Right" Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" 
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="#15803d"/>
                                        </Border>

                                        <!-- Boutons d'actions rapides (Renommer, Supprimer) -->
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button Command="{Binding DataContext.StartRenameVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="إعادة تسمية">
                                                <TextBlock Text="✏️" FontSize="12"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="حذف">
                                                <TextBlock Text="🗑️" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- COLONNE 1 : LECTEUR MULTIMÉDIA & DÉTAILS DU FICHIER       -->
        <!-- ======================================================== -->
        <Border Grid.Column="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Écran de lecture MediaElement -->
                    <RowDefinition Height="Auto"/> <!-- Contrôles du lecteur (Timeline, Play, Volume) -->
                    <RowDefinition Height="*"/>    <!-- Métadonnées & actions -->
                </Grid.RowDefinitions>

                <!-- 1. Écran de visualisation (MediaElement) -->
                <Border Grid.Row="0" Background="#000000" CornerRadius="10" Height="250" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="PlayerMediaElement"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      MediaOpened="OnMediaOpened"
                                      MediaEnded="OnMediaEnded"
                                      MediaFailed="OnMediaFailed"
                                      Volume="{Binding Volume}"
                                      IsMuted="{Binding IsMuted}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        <!-- Message d'erreur éventuel -->
                        <Border Background="#ccdc2626" CornerRadius="6" Padding="12,6"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasPlayerError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding PlayerStatusMessage}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Barre de contrôle du lecteur -->
                <StackPanel Grid.Row="1" Margin="0,12,0,16">
                    <!-- Barre de progression temporelle (Slider) -->
                    <Slider x:Name="PlayerProgressBar"
                            Minimum="0"
                            Maximum="{Binding TotalDurationSec}"
                            Value="{Binding PlaybackPositionSec, Mode=TwoWay}"
                            ValueChanged="OnScrubberValueChanged"
                            IsMoveToPointEnabled="True"
                            Height="20"
                            Margin="0,0,0,8"
                            Cursor="Hand"/>

                    <!-- Boutons et affichage du temps -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Bouton Play/Pause -->
                            <ColumnDefinition Width="*"/>    <!-- Temps écoulé / total -->
                            <ColumnDefinition Width="Auto"/> <!-- Volume & Plein écran -->
                        </Grid.ColumnDefinitions>

                        <!-- Bouton Lecture / Pause -->
                        <Button Grid.Column="0" Command="{Binding TogglePlayPauseCommand}" 
                                Background="#15803d" Foreground="White" Width="36" Height="36" 
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18"/></Style></Button.Resources>
                            <TextBlock Text="{Binding IsPlaying, Converter={x:Null}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="⏸"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Affichage du temps : 00:00 / 01:24 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding FormattedPlaybackPosition}" FontWeight="Bold" Foreground="#0f172a" FontSize="13" FlowDirection="LeftToRight"/>
                            <TextBlock Text=" / " Foreground="#64748b" FontSize="13"/>
                            <TextBlock Text="{Binding FormattedTotalDuration}" Foreground="#64748b" FontSize="13" FlowDirection="LeftToRight"/>
                        </StackPanel>

                        <!-- Volume et Plein écran -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Couper / Activer le son -->
                            <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" 
                                    Padding="6,4" Cursor="Hand" Margin="0,0,4,0">
                                <TextBlock Text="{Binding IsMuted, Converter={x:Null}}" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔊"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Text" Value="🔇"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Bouton Plein écran -->
                            <Button Command="{Binding ToggleFullscreenCommand}" Background="#f1f5f9" BorderBrush="#cbd5e1" 
                                    BorderThickness="1" Padding="8,4" Cursor="Hand" ToolTip="ملء الشاشة">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                <TextBlock Text="⛶" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 3. Fiche détaillée du média & actions -->
                <Border Grid.Row="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <!-- Titre de la vidéo -->
                        <TextBlock Text="{Binding SelectedVideo.CleanTitle, FallbackValue='اختر مقطعاً لتشغيله'}" 
                                   FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,8"/>

                        <!-- Métadonnées -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="👤 القارئ:" FontSize="12" Foreground="#64748b" Margin="0,0,6,0"/>
                                    <TextBlock Text="الشيخ صابر عبد الحكم" FontSize="12" FontWeight="SemiBold" Foreground="#0f172a"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖 الرواية:" FontSize="12" Foreground="#64748b" Margin="0,0,6,0"/>
                                    <TextBlock Text="ورش عن نافع" FontSize="12" FontWeight="SemiBold" Foreground="#15803d"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" 
                                    CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedVideo.FormatBadge, FallbackValue='MP4'}" 
                                           FontWeight="Bold" Foreground="#15803d" FontSize="12"/>
                            </Border>
                        </Grid>

                        <Separator Background="#e2e8f0" Margin="0,0,0,14"/>

                        <!-- Actions : Ouvrir dans l'explorateur & Lecteur externe -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding OpenVideosFolderCommand}" Background="#15803d" Foreground="White"
                                    FontWeight="SemiBold" FontSize="13" Padding="16,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="فتح موقع الملف 📁" Margin="0,0,4,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding PlayInExternalPlayerCommand}" Background="White" Foreground="#334155"
                                    FontWeight="SemiBold" FontSize="13" Padding="14,8" BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="مشغل خارجي ↗"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Modale de renommage intégrée -->
                <Grid Grid.RowSpan="3" Background="#80000000"
                      Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Border Background="White" CornerRadius="12" Padding="20" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="إعادة تسمية الملف" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding NewVideoName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding CancelRenameCommand}" Background="#f1f5f9" Foreground="#334155" 
                                        FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <TextBlock Text="إلغاء"/>
                                </Button>
                                <Button Command="{Binding ConfirmRenameCommand}" Background="#15803d" Foreground="White" 
                                        FontWeight="Bold" Padding="16,6" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <TextBlock Text="تأكيد التسمية"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
