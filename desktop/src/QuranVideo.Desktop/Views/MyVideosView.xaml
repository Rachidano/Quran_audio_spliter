<UserControl x:Class="QuranVideo.Desktop.Views.MyVideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QuranVideo.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MyVideosViewModel}"
             FlowDirection="RightToLeft"
             d:DesignHeight="850" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Actions Toolbar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <!-- Play in embedded player -->
                        <Button Command="{Binding PlaySelectedVideoCommand}" Background="#15803d" Foreground="White"
                                FontWeight="Bold" FontSize="14" Padding="18,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="تشغيل في المشغل الداخلي" Margin="0,0,6,0"/>
                                <TextBlock Text="▶"/>
                            </StackPanel>
                        </Button>

                        <!-- Rename -->
                        <Button Command="{Binding StartRenameVideoCommand}" Background="#f8fafc" Foreground="#0284c7"
                                FontWeight="Bold" FontSize="14" Padding="16,8" BorderThickness="1" BorderBrush="#bae6fd" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="تغيير اسم الملف المحدد">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="إعادة التسمية" Margin="0,0,6,0"/>
                                <TextBlock Text="✏️"/>
                            </StackPanel>
                        </Button>

                        <!-- Delete -->
                        <Button Command="{Binding DeleteVideoCommand}" Background="#fef2f2" Foreground="#dc2626"
                                FontWeight="Bold" FontSize="14" Padding="16,8" BorderThickness="1" BorderBrush="#fecaca" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="حذف الملف المحدد نهائياً بعد إيقاف تشغيله وتحريره">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="حذف الملف" Margin="0,0,6,0"/>
                                <TextBlock Text="🗑️"/>
                            </StackPanel>
                        </Button>

                        <!-- Open in explorer -->
                        <Button Command="{Binding OpenVideosFolderCommand}" Background="#f1f5f9" Foreground="#334155"
                                FontWeight="Bold" FontSize="14" Padding="16,8" BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="فتح المجلد" Margin="0,0,6,0"/>
                                <TextBlock Text="📁"/>
                            </StackPanel>
                        </Button>

                        <!-- Refresh -->
                        <Button Command="{Binding RefreshVideosCommand}" Background="#f8fafc" Foreground="#475569"
                                Padding="12,8" BorderThickness="1" BorderBrush="#e2e8f0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="تحديث 🔄"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="سجل المقاطع المنتجة في مساحة العمل" FontSize="16" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#059669" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Embedded Video / Audio Player Card -->
            <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16"
                    Visibility="{Binding IsPlayerActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- Player Header with filename & close button -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎬 مشغل الفيديو والصوت المدمج :" FontWeight="Bold" FontSize="15" Foreground="#0f172a" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedVideo.FileName}" FontWeight="Bold" FontSize="15" Foreground="#15803d" FlowDirection="LeftToRight"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding PlayInExternalPlayerCommand}" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1"
                                    Foreground="#475569" FontSize="12" Padding="10,4" Cursor="Hand" Margin="0,0,8,0" ToolTip="فتح بواسطة مشغل النظام الخارجي">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                <TextBlock Text="↗ مشغل خارجي"/>
                            </Button>

                            <Button Command="{Binding ClosePlayerCommand}" Background="#fef2f2" BorderBrush="#fecaca" BorderThickness="1"
                                    Foreground="#b91c1c" FontSize="12" Padding="10,4" Cursor="Hand" ToolTip="إغلاق المشغل وتحرير الملف">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                <TextBlock Text="إغلاق المشغل ✖"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Player Screen Container -->
                    <Border Background="#090d16" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Height="360" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="PlayerMediaElement"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Close"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          Volume="{Binding Volume}"
                                          IsMuted="{Binding IsMuted}"
                                          MediaOpened="OnMediaOpened"
                                          MediaEnded="OnMediaEnded"
                                          MediaFailed="OnMediaFailed"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Error Banner Overlay -->
                            <Border Background="#fef2f2" BorderBrush="#fca5a5" BorderThickness="1" CornerRadius="6" Padding="16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasPlayerError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠ " FontSize="18" Foreground="#b91c1c"/>
                                    <TextBlock Text="{Binding PlayerStatusMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#b91c1c"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Player Controls Bar -->
                    <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Play / Pause & Stop -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Button Command="{Binding TogglePlayPauseCommand}" Background="#15803d" Foreground="White"
                                        FontWeight="Bold" Padding="14,6" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="▶ تشغيل"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Content" Value="⏸ إيقاف مؤقت"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Command="{Binding StopCommand}" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1"
                                        Foreground="#334155" FontWeight="Bold" Padding="10,6" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <TextBlock Text="⏹ إيقاف"/>
                                </Button>
                            </StackPanel>

                            <!-- Scrubber Slider & Timing Display -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding FormattedPlaybackPosition}" FlowDirection="LeftToRight"
                                           FontSize="13" FontWeight="Bold" Foreground="#15803d" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <Slider Grid.Column="1" Minimum="0" Maximum="{Binding TotalDurationSec, FallbackValue=100}"
                                        Value="{Binding PlaybackPositionSec}"
                                        ValueChanged="OnScrubberValueChanged"
                                        IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" Cursor="Hand"/>

                                <TextBlock Grid.Column="2" Text="{Binding FormattedTotalDuration}" FlowDirection="LeftToRight"
                                           FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Volume Slider & Mute -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                    <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.1"
                                        Width="70" VerticalAlignment="Center" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Fullscreen Button -->
                            <Button Grid.Column="3" Command="{Binding ToggleFullscreenCommand}" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1"
                                    Padding="8,6" Cursor="Hand" Margin="4,0,0,0" ToolTip="ملء الشاشة / تصغير">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <TextBlock Text="⛶ ملء الشاشة" FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Inline Rename Dialog Bar -->
            <Border Grid.Row="2" Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                    Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock Text="إعادة تسمية الملف :" FontWeight="Bold" FontSize="14" Foreground="#0369a1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Text="{Binding NewVideoName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left" MinWidth="260"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ConfirmRenameCommand}" Background="#0284c7" Foreground="White"
                                FontWeight="Bold" FontSize="13" Padding="14,6" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="حفظ الاسم ✔"/>
                        </Button>
                        <Button Command="{Binding CancelRenameCommand}" Background="#e2e8f0" Foreground="#475569"
                                FontWeight="Bold" FontSize="13" Padding="14,6" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <TextBlock Text="إلغاء ✖"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 4. Videos List / Table -->
            <Border Grid.Row="3" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32"
                                Visibility="{Binding HasNoVideos, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="لا توجد مقاطع منشأة بعد في هذا المجلد" FontSize="18" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="اختر سورة وآيات من المعالج V3 أو استوديو الآية الواحدة لتوليد فيديوهات أو استخراج ملفات صوتية." FontSize="14" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- List of Videos -->
                    <ListBox ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedVideo}"
                             BorderThickness="0" Background="Transparent"
                             Visibility="{Binding HasVideos, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Video or Audio icon -->
                                        <Border Grid.Column="0" Background="#f0fdf4" Width="40" Height="40" CornerRadius="6" Margin="0,0,12,0">
                                            <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- File Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="#0f172a" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="#94a3b8" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="13" Foreground="#475569" 
                                                   VerticalAlignment="Center" Margin="24,0"/>

                                        <!-- Date -->
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedDate}" FontSize="12" Foreground="#64748b" 
                                                   FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <!-- Quick Row Actions -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Play in player -->
                                            <Button Command="{Binding DataContext.PlaySelectedVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Background="#f0fdf4" BorderBrush="#86efac" BorderThickness="1"
                                                    Padding="10,5" Cursor="Hand" Margin="0,0,6,0" ToolTip="تشغيل هذا المقطع">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <TextBlock Text="▶ تشغيل" FontSize="11" Foreground="#15803d" FontWeight="Bold"/>
                                            </Button>

                                            <!-- Rename -->
                                            <Button Command="{Binding DataContext.StartRenameVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1"
                                                    Padding="8,5" Cursor="Hand" Margin="0,0,6,0" ToolTip="إعادة تسمية هذا الملف">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <TextBlock Text="✏️ تعديل" FontSize="11" Foreground="#0284c7" FontWeight="Bold"/>
                                            </Button>

                                            <!-- Delete -->
                                            <Button Command="{Binding DataContext.DeleteVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Background="#fee2e2" BorderBrush="#fca5a5" BorderThickness="1"
                                                    Padding="8,5" Cursor="Hand" ToolTip="حذف هذا الملف نهائياً">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <TextBlock Text="🗑️ حذف" FontSize="11" Foreground="#b91c1c" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
