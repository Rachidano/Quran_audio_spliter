<Window x:Class="QuranVideo.Desktop.Views.AudioSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="القراء وروابط التلاوات"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="1180" Height="780" MinWidth="850" MinHeight="560"
        FontSize="14" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" Background="#f8fafc">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="btnBorder" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="btnBorder" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="btnBorder" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox Style (Vertical alignment & padding safe for Arabic fonts) -->
        <Style x:Key="ModernInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="inputBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" IsTabStop="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="inputBorder" Value="#0284c7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="inputBorder" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Header -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Row -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="BorderBrush" Value="#f1f5f9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f0fdf4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#ecfdf5"/>
                    <Setter Property="Foreground" Value="#0f172a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ProgressBar Style -->
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Background" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="3.5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" 
                                        CornerRadius="3.5" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="#f8fafc">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Card -->
        <Border Grid.Row="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0f172a"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#ecfdf5" Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0">
                    <TextBlock Text="🎙️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="القراء وروابط تحميل السور" FontSize="20" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock Text="إدارة وتعديل روابط التلاوات لكل قارئ وتنزيل ملفات السور بصيغة MP3 مباشرة. روابط الشيخ صابر عبد الحكم معتمدة ومجهزة مسبقاً."
                               FontSize="13" Foreground="#64748b" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Management & Configuration Panel (Responsive full-width layout) -->
        <Border x:Name="HeaderForm" Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" 
                CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0f172a"/>
            </Border.Effect>
            <StackPanel>
                <!-- Section A: Current Reciter & Settings (Full Width Responsive Wrap) -->
                <WrapPanel VerticalAlignment="Center">
                    <!-- Title / Icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,8">
                        <TextBlock Text="🎙️" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="القارئ الحالي :" FontWeight="Bold" FontSize="13" Foreground="#1e293b" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Reciter Picker -->
                    <ComboBox x:Name="Reciters" DisplayMemberPath="Name" MinWidth="210" Height="38" 
                              FontSize="13" SelectionChanged="OnReciterChanged" Margin="0,0,12,8" VerticalContentAlignment="Center"/>

                    <!-- Rename Box -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="الاسم :" Foreground="#475569" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ReciterName" Width="200" Height="38" Style="{StaticResource ModernInputBox}" 
                                 ToolTip="اسم القارئ — يمكن تعديله ثم الضغط على حفظ"/>
                    </StackPanel>

                    <!-- Default CheckBox -->
                    <CheckBox x:Name="DefaultChoice" Content="⭐ تعيين كافتراضي" FontWeight="SemiBold" 
                              VerticalAlignment="Center" Margin="0,0,16,8"/>

                    <!-- Save Button -->
                    <Button Content="💾 حفظ التعديلات" Click="OnSave" Style="{StaticResource ModernBtn}"
                            Background="#059669" Foreground="White" Padding="18,0" Height="38" Margin="0,0,0,8"/>
                </WrapPanel>

                <!-- Subtle Separator -->
                <Separator Background="#f1f5f9" Height="1" Margin="0,4,0,10"/>

                <!-- Section B: Add New Reciter (Full Width Responsive Wrap) -->
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                        <TextBlock Text="➕" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إضافة قارئ جديد :" FontWeight="Bold" FontSize="13" Foreground="#1e293b" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox x:Name="NewName" Width="220" Height="38" Style="{StaticResource ModernInputBox}" 
                             Margin="0,0,10,6" ToolTip="اكتب اسم القارئ الجديد هنا"/>

                    <Button Content="➕ إضافة القارئ" Click="OnAddReciter" Style="{StaticResource ModernBtn}"
                            Background="#0284c7" Foreground="White" Padding="16,0" Height="38" Margin="0,0,14,6"/>

                    <TextBlock Text="ℹ️ بعد إضافة القارئ، الصق روابط السور الـ114 في الجدول أدناه واضغط حفظ." 
                               FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 3. Links DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0f172a"/>
            </Border.Effect>
            <DataGrid x:Name="LinksGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                      EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                      Background="White" BorderThickness="0">
                <DataGrid.Columns>
                    <!-- Number Column -->
                    <DataGridTemplateColumn Header="الرقم" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" 
                                        CornerRadius="6" Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="12" Foreground="#64748b" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Surah Name Column -->
                    <DataGridTemplateColumn Header="السورة" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#0f172a" 
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Direct Download URL Column -->
                    <DataGridTemplateColumn Header="رابط التحميل المباشر (MP3)" Width="*" MinWidth="380">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" 
                                        CornerRadius="6" Margin="6,4" Padding="6,2">
                                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                             VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                             FontSize="12" Foreground="#334155" ToolTip="{Binding Url}" FontFamily="Consolas, Segoe UI"
                                             AutomationProperties.Name="رابط تحميل السورة"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Column (Pill Badges) -->
                    <DataGridTemplateColumn Header="حالة الملف" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="statusBadge" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1">
                                    <TextBlock x:Name="statusText" Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" Foreground="#64748b"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                        <Setter TargetName="statusBadge" Property="Background" Value="#dcfce7"/>
                                        <Setter TargetName="statusBadge" Property="BorderBrush" Value="#86efac"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#15803d"/>
                                        <Setter TargetName="statusText" Property="Text" Value="✔ تم التنزيل"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                        <Setter TargetName="statusBadge" Property="Background" Value="#e0f2fe"/>
                                        <Setter TargetName="statusBadge" Property="BorderBrush" Value="#7dd3fc"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#0369a1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Download Action Column -->
                    <DataGridTemplateColumn Header="الإجراء" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="dlBtn" Tag="{Binding}" Click="OnDownload" Style="{StaticResource ModernBtn}"
                                        Background="#059669" Foreground="White" Padding="10,5" Height="32" Margin="4">
                                    <TextBlock x:Name="dlBtnText" Text="⬇️ تنزيل" FontSize="12"/>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                        <Setter TargetName="dlBtn" Property="Background" Value="#f0fdf4"/>
                                        <Setter TargetName="dlBtn" Property="BorderBrush" Value="#a7f3d0"/>
                                        <Setter TargetName="dlBtn" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="dlBtnText" Property="Foreground" Value="#047857"/>
                                        <Setter TargetName="dlBtnText" Property="Text" Value="🔄 إعادة"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Bottom Progress & Status Bar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,12,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#0f172a"/>
            </Border.Effect>
            <StackPanel>
                <ProgressBar x:Name="DownloadProgress" Height="7" Minimum="0" Maximum="100"/>
                <DockPanel Margin="0,10,0,0">
                    <Button x:Name="CancelDownload" Content="⏹ إلغاء التنزيل" Click="OnCancel" IsEnabled="False" 
                            Style="{StaticResource ModernBtn}" Background="#fee2e2" Foreground="#b91c1c" 
                            BorderBrush="#fca5a5" BorderThickness="1" DockPanel.Dock="Left" Padding="14,6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="💡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="جارٍ فحص قائمة القراء..." FontWeight="SemiBold" 
                                   Foreground="#334155" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
