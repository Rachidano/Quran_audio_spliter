<UserControl x:Class="QuranVideo.Desktop.Views.BatchExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QuranVideo.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:BatchExportViewModel}"
             FlowDirection="RightToLeft"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Selection & Enqueue Panel (L09-01) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="تصدير الفيديوهات بالدفعة (قائمة الانتظار)" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock Text="معالجة متتالية مستقرة مع حفظ الحالة والتعافي عند الانقطاع" FontSize="12" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Surah Picker -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="السورة :" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Surahs}" SelectedItem="{Binding SelectedSurah}" Height="38" FontSize="14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Start Ayah -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="من الآية :" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding StartAyah, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- End Ayah -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="إلى الآية :" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EndAyah, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Export Type (Video vs Audio) -->
                    <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="نوع المخرج :" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton IsChecked="{Binding IsVideoExport, Mode=TwoWay}" GroupName="BatchExportMode" Content="فيديو (MP4)" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <RadioButton IsChecked="{Binding IsAudioOnly, Mode=TwoWay}" GroupName="BatchExportMode" Content="صوت (MP3)" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Orientation (Enabled only when Video is selected) -->
                    <StackPanel Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center" IsEnabled="{Binding IsVideoExport}">
                        <TextBlock Text="تنسيق العرض :" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton IsChecked="{Binding IsHorizontal, Mode=TwoWay}" GroupName="BatchOrientation" Content="أفقي 16:9" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <RadioButton IsChecked="{Binding IsVertical, Mode=TwoWay}" GroupName="BatchOrientation" Content="عمودي 9:16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Add Button -->
                    <Button Grid.Column="5" Command="{Binding EnqueueRangeCommand}" Background="#0284c7" Foreground="White"
                            FontWeight="Bold" FontSize="14" Padding="18,8" Height="38" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="إضافة للقائمة ➕"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Controls & Actions Toolbar (L09-04) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Start Queue Button -->
                    <Button Command="{Binding StartQueueCommand}" Background="#15803d" Foreground="White"
                            FontWeight="Bold" FontSize="14" Padding="18,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶ بدء تصدير القائمة" Margin="0,0,6,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Stop Queue Button -->
                    <Button Command="{Binding StopQueueCommand}" Background="#ef4444" Foreground="White"
                            FontWeight="Bold" FontSize="14" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <TextBlock Text="⏹ إيقاف مؤقت"/>
                    </Button>

                    <!-- Open Videos Folder Button -->
                    <Button Command="{Binding OpenVideosFolderCommand}" Background="#f1f5f9" Foreground="#334155"
                            FontWeight="Bold" FontSize="14" Padding="14,8" BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 فتح المجلد"/>
                        </StackPanel>
                    </Button>

                    <!-- Clear Finished / Cancelled Button -->
                    <Button Command="{Binding ClearFinishedJobsCommand}" Background="#f8fafc" Foreground="#475569"
                            FontWeight="SemiBold" FontSize="13" Padding="12,8" BorderThickness="1" BorderBrush="#cbd5e1" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="إزالة المهام المكتملة أو الملغاة أو الفاشلة من القائمة">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <TextBlock Text="🧹 مسح المكتملة"/>
                    </Button>

                    <!-- Clear All Non-Running Button -->
                    <Button Command="{Binding ClearAllJobsCommand}" Background="#fef2f2" Foreground="#b91c1c"
                            FontWeight="SemiBold" FontSize="13" Padding="12,8" BorderThickness="1" BorderBrush="#fecaca" Cursor="Hand" Margin="0,0,12,0"
                            ToolTip="إفراغ القائمة بالكامل (المهام غير قيد التشغيل)">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <TextBlock Text="🗑️ إفراغ القائمة"/>
                    </Button>

                    <!-- Filter checkbox -->
                    <CheckBox IsChecked="{Binding FilterBySelectedSurah}" Content="عرض مهام السورة المحددة فقط 🎯"
                              FontWeight="Bold" Foreground="#0369a1" VerticalAlignment="Center" Margin="6,0,0,0"
                              ToolTip="عند تفعيل هذا الخيار، يتم عرض مهام السورة المختارة في القائمة لتسهيل المتابعة"/>
                </StackPanel>

                <!-- Status Text -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#334155" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- 3. Queue Items List (L09-03) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📋" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="قائمة التصدير فارغة حالياً" FontSize="17" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
                    <TextBlock Text="حدد السورة والآيات في الأعلى واضغط 'إضافة للقائمة' لجدولة الفيديوهات." FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Jobs List -->
                <ListBox ItemsSource="{Binding Jobs}" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding HasJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Index / Status Icon -->
                                    <Border Grid.Column="0" Background="#f8fafc" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="12" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Ayah Identification -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AyahId, StringFormat='آية {0}'}" FontSize="15" FontWeight="Bold" Foreground="#0f172a"/>
                                        <TextBlock Text="{Binding Orientation, StringFormat='التنسيق: {0}'}" FontSize="12" Foreground="#64748b"/>
                                    </StackPanel>

                                    <!-- Progress / Duration -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" MinWidth="120">
                                        <TextBlock Text="{Binding Status, Converter={x:Null}}" FontWeight="SemiBold" FontSize="13" Foreground="#1e293b"/>
                                        <ProgressBar Value="{Binding ProgressPercent}" Height="5" Maximum="100" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Error message / Output file -->
                                    <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}" FontSize="11" Foreground="#dc2626" 
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0"/>

                                    <!-- Actions: Retry / Cancel / Delete -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Background="#e0f2fe" Foreground="#0369a1" Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                                ToolTip="إعادة محاولة المهمة">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            <TextBlock Text="🔄 إعادة المحاولة" FontSize="11"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Background="#fee2e2" Foreground="#b91c1c" Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                                ToolTip="إلغاء التصدير">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            <TextBlock Text="✖ إلغاء" FontSize="11"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Background="#fef2f2" Foreground="#dc2626" BorderBrush="#fecaca" BorderThickness="1"
                                                Padding="8,4" Cursor="Hand" ToolTip="حذف هذه المهمة نهائياً من القائمة">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            <TextBlock Text="🗑️ حذف" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
