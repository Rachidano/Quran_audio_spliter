<Window x:Class="QuranVideo.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuranVideo.Desktop.ViewModels"
        xmlns:views="clr-namespace:QuranVideo.Desktop.Views"
        mc:Ignorable="d"
        Title="صanع مقاطع القرآن — لطريقة ورش عن نافع" 
        Icon="pack://application:,,,/Resources/app.ico"
        Height="800" Width="1240" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="#f8fafc">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- DataTemplates for Main Views -->
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudioViewModel}">
            <views:StudioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchExportViewModel}">
            <views:BatchExportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CollectionsViewModel}">
            <views:CollectionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyVideosViewModel}">
            <views:MyVideosView/>
        </DataTemplate>

        <!-- Base Sidebar Nav Button Template -->
        <ControlTemplate x:Key="SidebarNavButtonTemplate" TargetType="Button">
            <Border x:Name="RootBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" 
                    Padding="14,11" 
                    Margin="10,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon / Emoji -->
                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}" 
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <!-- Label -->
                    <TextBlock Grid.Column="1" 
                               Text="{TemplateBinding Content}" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               Margin="8,0,0,0"/>

                    <!-- Active Right Edge Pill Indicator -->
                    <Border x:Name="ActivePill" 
                            Grid.Column="2" 
                            Width="3" Height="20" 
                            CornerRadius="2" 
                            Background="#15803d" 
                            Visibility="Collapsed"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RootBorder" Property="Background" Value="#f1f5f9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <!-- Layout: Column 0 = Right Sidebar (RTL), Column 1 = Main Workspace -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- SIDEBAR DE NAVIGATION (DROITE EN RTL)                      -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                
                <!-- 1. En-tête : Marque & Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="16,22,16,16" HorizontalAlignment="Center">
                    <Border Background="#f0fdf4" BorderBrush="#dcfce7" BorderThickness="1" 
                            CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Center">
                        <TextBlock Text="📖" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="صانع مقاطع القرآن" FontSize="16" FontWeight="Bold" Foreground="#0f172a" 
                               HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="لطريقة ورش عن نافع" FontSize="12" FontWeight="SemiBold" Foreground="#15803d" 
                               HorizontalAlignment="Center"/>
                    <Separator Background="#f1f5f9" Margin="0,16,0,8"/>
                </StackPanel>

                <!-- 2. Pied de la barre latérale : Paramètres & Version -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,16">
                    <Separator Background="#f1f5f9" Margin="6,0,6,12"/>
                    <Button Command="{Binding ToggleSettingsCommand}"
                            Tag="⚙️"
                            Content="الإعدادات"
                            Cursor="Hand"
                            Template="{StaticResource SidebarNavButtonTemplate}"
                            Background="Transparent"
                            Foreground="#475569"
                            FontWeight="SemiBold"/>
                    <TextBlock Text="تصور الواجهة • V4" FontSize="11" Foreground="#94a3b8" 
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 3. Menu principal de navigation -->
                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                    
                    <!-- 1. المكتبة -->
                    <Button Command="{Binding SelectLibraryCommand}"
                            Content="المكتبة"
                            Tag="📚"
                            Cursor="Hand"
                            Template="{StaticResource SidebarNavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Library">
                                        <Setter Property="Background" Value="#ebfdf5"/>
                                        <Setter Property="Foreground" Value="#15803d"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 2. استوديو التقطيع -->
                    <Button Command="{Binding SelectAudioStudioCommand}"
                            Content="استوديو التقطيع"
                            Tag="✂️"
                            Cursor="Hand"
                            Template="{StaticResource SidebarNavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAudioStudioTabActive}" Value="True">
                                        <Setter Property="Background" Value="#ebfdf5"/>
                                        <Setter Property="Foreground" Value="#15803d"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 3. إعداد الفيديو -->
                    <Button Command="{Binding SelectVideoStudioCommand}"
                            Content="إعداد الفيديو"
                            Tag="🎬"
                            Cursor="Hand"
                            Template="{StaticResource SidebarNavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVideoStudioTabActive}" Value="True">
                                        <Setter Property="Background" Value="#ebfdf5"/>
                                        <Setter Property="Foreground" Value="#15803d"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 4. فيديوهاتي -->
                    <Button Command="{Binding SelectMyVideosCommand}"
                            Content="فيديوهاتي"
                            Tag="📁"
                            Cursor="Hand"
                            Template="{StaticResource SidebarNavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="MyVideos">
                                        <Setter Property="Background" Value="#ebfdf5"/>
                                        <Setter Property="Foreground" Value="#15803d"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 5. مجموعاتي -->
                    <Button Command="{Binding SelectCollectionsCommand}"
                            Content="مجموعاتي"
                            Tag="🗂️"
                            Cursor="Hand"
                            Template="{StaticResource SidebarNavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Collections">
                                        <Setter Property="Background" Value="#ebfdf5"/>
                                        <Setter Property="Foreground" Value="#15803d"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ESPACE DE TRAVAIL PRINCIPAL (GAUCHE EN RTL)               -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Vue Active -->
            <ContentControl Grid.Row="0" Content="{Binding CurrentContentViewModel}"/>

            <!-- Barre de statut inférieure discrète -->
            <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="20,7">
                <DockPanel>
                    <!-- Chemin du répertoire de travail LTR -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="مجلد العمل: " Foreground="#64748b" FontSize="11"/>
                        <TextBlock Text="{Binding WorkspacePath}" FlowDirection="LeftToRight" Foreground="#0f172a" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Texte d'état -->
                    <TextBlock Text="{Binding StatusText}" Foreground="#15803d" FontWeight="SemiBold" FontSize="12" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODALE PARAMÈTRES (OVERLAY)                              -->
        <!-- ======================================================== -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <views:SettingsDialog DataContext="{Binding SettingsVM}"/>
        </Grid>
    </Grid>
</Window>
